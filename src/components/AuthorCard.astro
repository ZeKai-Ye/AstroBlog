---
/**
 * Author card — the post page sidebar, reused as a tile in the 关于 page's
 * 作者一览 grid.
 *
 * Paper design: a hairline box, square corners, the avatar cropped square, the
 * name in serif. Pass `href` to make the whole card a link; without it the card
 * stays an <aside>, which is what the post sidebar wants.
 */
import Figure from './Figure.astro';
import { SITE, asset } from '../config';
import type { Author } from '../authors';

interface Props {
	/** A collection entry. Omit to fall back to SITE.author. */
	author?: Author;
	/** Link target; turns the card into an <a>. */
	href?: string;
	/** Optional trailing line, e.g. "3 篇". */
	note?: string;
}

const { author, href, note } = Astro.props;

const name = author?.data.name ?? SITE.author.name;
const bio = author?.data.bio ?? SITE.author.bio;
const role = author?.data.role ?? '';
const avatar = asset(author?.data.avatar ?? SITE.images.avatar);

const Tag = href ? 'a' : 'aside';
---

<Tag class:list={['author', href && 'author--link']} {...href ? { href } : {}}>
	<div class="author__avatar">
		<Figure
			src={avatar}
			alt={`${name} 的头像`}
			label="头像"
			ratio="1 / 1"
			sizes="(max-width: 48rem) 30vw, 12rem"
		/>
	</div>

	<div class="author__text">
		{role && <p class="author__role">{role}</p>}
		<p class="author__name">{name}</p>
		{bio && <p class="author__bio">{bio}</p>}
	</div>

	{note && <p class="author__note">{note}</p>}
</Tag>

<style>
	.author {
		display: grid;
		grid-template-columns: 3.5rem minmax(0, 1fr);
		gap: 14px 16px;
		align-items: start;
		padding: 16px;
		border: 1px solid var(--line);
	}

	.author--link {
		transition:
			border-color 0.25s ease,
			transform 0.35s var(--ease);
	}

	.author--link:hover {
		border-color: var(--line-strong);
		transform: translateY(-3px);
	}

	.author__avatar {
		grid-row: 1 / 3;
	}

	.author__role {
		color: var(--accent);
		font-size: 0.6875rem;
		letter-spacing: 0.14em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.author__name {
		margin-block-start: 3px;
		font-family: var(--font-serif);
		font-size: 1.0625rem;
		line-height: 1.35;
		letter-spacing: -0.02em;
	}

	.author__bio {
		margin-block-start: 6px;
		color: var(--muted);
		font-size: 0.8125rem;
		line-height: 1.75;
	}

	.author__note {
		grid-column: 2;
		padding-block-start: 10px;
		color: var(--muted-soft);
		font-size: 0.71875rem;
		letter-spacing: 0.08em;
		border-block-start: 1px solid var(--line);
		font-variant-numeric: tabular-nums;
	}

	/* The 作者一览 tiles sit in a grid and read better with a taller avatar. */
	:global(.authors-grid) .author {
		grid-template-columns: 4.5rem minmax(0, 1fr);
		padding: 20px;
	}
</style>
