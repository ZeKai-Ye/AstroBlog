---
/**
 * Back to top.
 *
 * Not in the design, but a long ledger needs it. It borrows the paper
 * vocabulary: a 40px circle, one hairline, an ink arrow. Kept out of the tab
 * order and the accessibility tree until the reader is past the first screen —
 * site.ts toggles `.is-visible` from the same scroll handler as the progress
 * line, so there is one scroll listener rather than two.
 */
---

<button class="to-top" type="button" data-to-top>
	<span class="sr-only">回到顶部</span>
	<svg class="to-top__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
		<path
			d="M12 19V5M12 5 6 11M12 5l6 6"
			fill="none"
			stroke="currentColor"
			stroke-width="1.4"
			stroke-linecap="round"
			stroke-linejoin="round"></path>
	</svg>
</button>

<style>
	.to-top {
		position: fixed;
		z-index: 60;
		inset-block-end: clamp(1rem, 2.2vw, 2rem);
		inset-inline-end: clamp(1rem, 2.2vw, 2rem);
		display: grid;
		width: clamp(2.5rem, 3.2vw, 2.9rem);
		aspect-ratio: 1;
		place-items: center;
		color: var(--ink);
		background: var(--paper-soft);
		border: 1px solid var(--line);
		border-radius: 50%;
		box-shadow: 0 10px 24px rgb(58 49 35 / 0.08);

		/* Hidden until the reader is past the first screen. */
		opacity: 0;
		visibility: hidden;
		translate: 0 0.5rem;
		transition:
			opacity 0.25s var(--ease),
			translate 0.25s var(--ease),
			visibility 0.25s,
			background 0.25s ease,
			border-color 0.25s ease;
	}

	.to-top.is-visible {
		opacity: 1;
		visibility: visible;
		translate: 0 0;
	}

	.to-top:hover {
		background: var(--paper-deep);
		border-color: var(--line-strong);
	}

	.to-top__icon {
		width: 50%;
		height: 50%;
	}

	@media (prefers-reduced-motion: reduce) {
		.to-top {
			translate: 0;
		}
	}
</style>
