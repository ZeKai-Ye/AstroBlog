---
/**
 * An image slot.
 *
 * With a source it is just a photograph inside a hairline frame — square
 * corners, no rounding, because the paper design has none. Without one it draws
 * the frame's own furniture: the two hairlines that cross at the centre, the
 * slot's name in serif, and a tiny IMAGE marker in the corner. That is a nicer
 * empty state than a grey block, and it still says "a picture goes here".
 */
import { Image } from 'astro:assets';

interface Props {
	src?: ImageMetadata;
	alt: string;
	/** Caption for the empty state. The mockup wrote 图片 / 头像. */
	label?: string;
	/** CSS `aspect-ratio` value. */
	ratio?: string;
	/** `sizes` hint so the browser picks a sensibly sized srcset entry. */
	sizes?: string;
	class?: string;
}

const {
	src,
	alt,
	label = '图片',
	ratio = '4 / 3',
	sizes = '(max-width: 48rem) 100vw, 50vw',
	class: className = '',
} = Astro.props;
---

<figure class:list={['slot', className]} style={`--slot-ratio: ${ratio}`}>
	{
		src ? (
			<Image src={src} alt={alt} widths={[480, 800, 1200]} sizes={sizes} />
		) : (
			<span class="slot__empty" role="img" aria-label={alt}>
				<span class="slot__cross" aria-hidden="true"></span>
				<span class="slot__label">{label}</span>
				<span class="slot__marker" aria-hidden="true">IMAGE</span>
			</span>
		)
	}
</figure>

<style>
	.slot {
		position: relative;
		margin: 0;
		aspect-ratio: var(--slot-ratio);
		overflow: hidden;
		background: var(--paper-deep);
		border: 1px solid var(--line);
	}

	.slot :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.slot__empty {
		position: relative;
		display: grid;
		height: 100%;
		place-items: center;
	}

	/* Two hairlines through the middle, like a crop guide. */
	.slot__cross {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, transparent 49.9%, var(--line) 50%, transparent 50.1%),
			linear-gradient(0deg, transparent 49.9%, var(--line) 50%, transparent 50.1%);
		opacity: 0.7;
	}

	.slot__label {
		position: relative;
		color: var(--muted);
		font-family: var(--font-serif);
		font-size: clamp(1.1rem, 2vw, 1.75rem);
		letter-spacing: 0.22em;
		text-indent: 0.22em;
	}

	.slot__marker {
		position: absolute;
		inset-block-start: 12px;
		inset-inline-start: 14px;
		color: var(--muted-soft);
		font-size: 0.4375rem;
		letter-spacing: 0.18em;
	}
</style>
