---
/**
 * One row of a ledger — the demo's article row, used by the home page, the 时日
 * index and an author's page.
 *
 * Five columns: number, title, category, date, arrow. The hover wash is a
 * pseudo-element rather than a background so it can bleed past the text column,
 * and the whole row is one link so nothing inside needs its own hit area.
 *
 * The row also carries its own card as data attributes (`data-preview-*`).
 * The home page's preview panel copies those across — one source of truth, no
 * duplicated copy in the markup.
 */
import type { CollectionEntry } from 'astro:content';
import { formatDateDot, isoDate, withBase } from '../config';

interface Props {
	post: CollectionEntry<'blog'>;
	/** Zero-based position; rendered as 01, 02, … */
	index?: number;
}

const { post, index = 0 } = Astro.props;
const { data } = post;
const href = withBase(`/blog/${post.id}/`);
const number = String(index + 1).padStart(2, '0');
const category = data.tags[0] ?? '笔记';
---

<li class="row">
	<a
		class="row__link"
		href={href}
		data-preview
		data-preview-index={number}
		data-preview-category={category}
		data-preview-title={data.title}
		data-preview-excerpt={data.description}
		data-preview-meta={formatDateDot(data.pubDate)}
	>
		<span class="row__index" aria-hidden="true">{number}</span>
		<span class="row__title">{data.title}</span>
		<span class="row__category">{category}</span>
		<time class="row__date" datetime={isoDate(data.pubDate)}>
			{formatDateDot(data.pubDate)}
		</time>
		<span class="circle-link row__arrow" aria-hidden="true">↗</span>
	</a>
</li>

<style>
	.row {
		border-block-end: 1px solid var(--line);
	}

	.row__link {
		position: relative;
		isolation: isolate;
		display: grid;
		grid-template-columns: 2.4rem minmax(0, 1fr) 5rem 6.2rem 28px;
		gap: 15px;
		align-items: center;
		padding-block: 21px;
		text-align: left;
	}

	/* The hover wash, allowed to bleed a little past the column. */
	.row__link::before {
		position: absolute;
		inset: 0 calc(var(--pad) * -0.16);
		z-index: -1;
		content: '';
		background: var(--paper-soft);
		opacity: 0;
		transition: opacity 0.35s ease;
	}

	.row__link:hover::before,
	.row__link:focus-visible::before {
		opacity: 0.8;
	}

	.row__index {
		color: var(--accent-text);
		font-family: var(--font-serif);
		font-size: 0.84375rem;
		line-height: 1.4;
	}

	.row__title {
		font-family: var(--font-serif);
		font-size: clamp(1.2rem, 0.95rem + 0.9vw, 1.85rem);
		line-height: 1.35;
		letter-spacing: -0.03em;
		transition: transform 0.4s var(--ease);
	}

	.row__category,
	.row__date {
		color: var(--muted);
		font-size: 0.8125rem;
		letter-spacing: 0.05em;
	}

	.row__date {
		text-align: right;
		font-variant-numeric: tabular-nums;
	}

	.row__arrow {
		justify-self: end;
	}

	.row__link:hover .row__title,
	.row__link:focus-visible .row__title {
		transform: translateX(7px);
	}

	.row__link:hover .row__arrow,
	.row__link:focus-visible .row__arrow {
		color: var(--paper);
		background: var(--ink);
		border-color: var(--ink);
		transform: rotate(45deg);
	}

	@media (max-width: 48rem) {
		.row__link {
			grid-template-columns: 1.7rem minmax(0, 1fr) 28px;
			gap: 12px;
			padding-block: 18px;
		}

		.row__index {
			align-self: start;
			padding-block-start: 0.45em;
		}

		.row__title {
			font-size: 1.15rem;
		}

		.row__category {
			grid-column: 2;
			margin-block-start: -8px;
			font-size: 0.75rem;
		}

		.row__date {
			display: none;
		}

		.row__arrow {
			grid-column: 3;
			grid-row: 1 / 3;
			align-self: center;
		}

		.row__link:hover .row__title {
			transform: translateX(3px);
		}
	}
</style>
