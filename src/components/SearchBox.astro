---
/**
 * The search field.
 *
 * A static site has no server to query, so this GETs `?q=` to /search/, which
 * filters a build-time index in the browser. The design is the demo's letter
 * field: a single hairline under the input, an arrow at the end, no box.
 */
import { withBase } from '../config';

interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
---

<form class:list={['search', className]} action={withBase('/search/')} method="get" role="search">
	<label class="sr-only" for="site-search">搜索</label>
	<input
		class="search__input"
		id="site-search"
		type="search"
		name="q"
		placeholder="搜索文章…"
		autocomplete="off"
	/>
	<button class="search__button" type="submit">
		<span class="sr-only">提交搜索</span>
		<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
			<circle cx="10.5" cy="10.5" r="7" stroke="currentColor" stroke-width="1.4"></circle>
			<path d="M15.6 15.6 21 21" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"
			></path>
		</svg>
	</button>
</form>

<style>
	.search {
		display: flex;
		align-items: center;
		gap: 12px;
		border-block-end: 1px solid var(--line-strong);
		transition: border-color 0.3s ease;
	}

	.search:focus-within {
		border-color: var(--accent);
	}

	.search__input {
		flex: 1;
		min-width: 0;
		padding-block: 11px;
		font-family: var(--font-sans);
		font-size: 0.9375rem;
		letter-spacing: 0.02em;
		color: var(--ink);
		background: transparent;
		border: 0;
		outline: none;
	}

	.search__input::placeholder {
		color: var(--muted);
		opacity: 1;
	}

	/* Hides the WebKit clear affordance so the magnifier keeps its place. */
	.search__input::-webkit-search-cancel-button {
		appearance: none;
	}

	.search__button {
		flex: none;
		display: grid;
		width: 1.5rem;
		height: 1.5rem;
		place-items: center;
		color: var(--muted);
		transition: color 0.2s ease;
	}

	.search__button:hover {
		color: var(--ink);
	}

	.search__button svg {
		width: 100%;
		height: 100%;
	}
</style>
