---
/**
 * Footer — the demo's thin colophon strip: a copyright line, the short nav and
 * a note about how the page is made, all on one hairline rule.
 *
 * The 搜索 page has no nav entry of its own (the masthead stays at four items),
 * so the footer is where it lives.
 */
import { SITE, withBase } from '../config';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container site-footer__inner">
		<p class="site-footer__copy">© <span data-year>{year}</span> {SITE.title}</p>

		<nav class="site-footer__nav" aria-label="页脚导航">
			{
				SITE.nav.map((item) => (
					<a href={withBase(item.href)}>{item.zh}</a>
				))
			}
			<a href={withBase('/search/')}>搜索</a>
		</nav>

		<p class="site-footer__colophon">
			<span>Colophon — {SITE.footerNote}</span>
			<span>纸、墨与一点 JavaScript · 随日升日落切换（东八区 · 北纬 23°）</span>
		</p>
	</div>
</footer>

<style>
	.site-footer {
		flex: none;
		padding-block: 22px 32px;
		border-block-start: 1px solid var(--line);
	}

	.site-footer__inner {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 18px 34px;
		color: var(--muted);
		font-size: 0.8125rem;
		line-height: 1.85;
		letter-spacing: 0.04em;
	}

	.site-footer__nav {
		display: flex;
		flex-wrap: wrap;
		gap: 2px 18px;
	}

	.site-footer__nav a {
		padding-block: 3px;
		transition: color 0.25s ease;
	}

	.site-footer__nav a:hover {
		color: var(--ink);
	}

	.site-footer__colophon {
		max-width: 34rem;
		text-align: right;
	}

	.site-footer__colophon span {
		display: block;
	}

	@media (max-width: 48rem) {
		.site-footer__inner {
			flex-direction: column;
			gap: 10px;
		}

		.site-footer__colophon {
			text-align: left;
		}
	}
</style>
