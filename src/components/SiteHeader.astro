---
/**
 * Masthead — the top 301px of both frames in `ui设计.free`.
 *
 * The mockup stacks two things on the tan background:
 *   y 0–181    a centred 960px-wide block holding the wordmark
 *              (drawn as a grey placeholder box: "待添加的标题主图标位置")
 *   y 211–301  four 320px nav columns, each two lines — Chinese over Greek
 *
 * That grey block was a placeholder for the title mark, and it now holds one:
 * set `images.logo` to a file in `src/assets/` and it is drawn there at the
 * mockup's own 960x181 proportions. With no picture set the site title is set as
 * type instead, which is what the grey block looked like when it was empty.
 */
import { Image } from 'astro:assets';
import { SITE, asset, withBase } from '../config';

const path = Astro.url.pathname;
const home = withBase('/');
/* `Astro.url.pathname` already carries the base, so compare against prefixed
   hrefs. The home link needs an exact match or it would light up everywhere. */
const isActive = (href: string) => {
	const full = withBase(href);
	return full === home ? path === home : path.startsWith(full);
};

const logo = asset(SITE.images.logo);
---

<header class="masthead">
	<div class="masthead__logo">
		<a class="masthead__wordmark" href={home}>
			{
				logo ? (
					<Image
						class="masthead__mark"
						src={logo}
						/* The link's only content, so the alt is what names it. */
						alt={SITE.title}
						widths={[480, 960]}
						sizes="(max-width: 30rem) 80vw, 30rem"
						/* Above the fold on every page, so never defer it. */
						loading="eager"
						fetchpriority="high"
					/>
				) : (
					SITE.title
				)
			}
		</a>
	</div>

	<nav class="masthead__nav" aria-label="主导航">
		<ul class="masthead__list">
			{
				SITE.nav.map((item) => (
					<li>
						<a
							class:list={['masthead__link', { 'is-active': isActive(item.href) }]}
							href={withBase(item.href)}
							aria-current={isActive(item.href) ? 'page' : undefined}
						>
							<span>{item.zh}</span>
							<span class="masthead__greek">{item.greek}</span>
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	.masthead {
		/*
			The mockup paints this plate in the *cream* band colour and gives it a
			0/6/4 25%-black shadow (Lunacy: `fill:"FFF1D4"`, `shadows:[{radius:4,
			offset:[0,6],color:"40000000"}]`) — it is a raised plate sitting over the
			tan frame, not a strip of the tan itself. Post pages swap in the
			translucent variant (`CCFFF1D4`) over their own cream fill.
		*/
		background: var(--masthead-bg, var(--c-cream));
		box-shadow: 0 6px 4px rgb(0 0 0 / 0.25);
	}

	/*
		Scaled down from the mockup's 301px/181px masthead, which ate a quarter
		of the first screen. At 1920 this lands at roughly 178px: a 100px
		wordmark block, an 18px gap, then a 60px nav row at the 24px nav size.
	*/
	.masthead__logo {
		display: grid;
		place-items: center;
		min-height: clamp(3rem, 0.75rem + 4.6vw, 6.25rem);
		padding-inline: var(--gutter);
	}

	.masthead__wordmark {
		font-size: clamp(1.125rem, 0.5rem + 1.45vw, 1.75rem);
		font-weight: 700;
		letter-spacing: 0.06em;
		line-height: 1.2;
		text-align: center;
		transition: opacity 0.2s var(--ease);
	}

	.masthead__wordmark:hover {
		opacity: 0.65;
	}

	/*
		The picture fills the block by height. `width: auto` plus `max-width`
		is ratio-safe: when the max-width bites, the browser recomputes the
		height from the intrinsic ratio rather than squashing it.
	*/
	.masthead__mark {
		display: block;
		height: clamp(2.5rem, 0.75rem + 4vw, 5rem);
		width: auto;
		max-width: 100%;
	}

	.masthead__nav {
		padding-block: clamp(0.5rem, 0.95vw, 1.1rem) 0;
	}

	.masthead__list {
		width: min(100% - var(--gutter) * 2, var(--content));
		margin-inline: auto;
		padding: 0;
		list-style: none;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
	}

	.masthead__link {
		display: flex;
		flex-direction: column;
		align-items: center;
		font-size: var(--fs-nav);
		line-height: 1.25;
		text-align: center;
		color: var(--c-ink-muted);
		transition: color 0.2s var(--ease);
	}

	.masthead__greek {
		letter-spacing: 0.04em;
	}

	.masthead__link:hover,
	.masthead__link.is-active {
		color: var(--c-ink);
	}

	@media (max-width: 30rem) {
		.masthead__list {
			grid-template-columns: repeat(2, 1fr);
			row-gap: 1.25rem;
		}
	}
</style>
