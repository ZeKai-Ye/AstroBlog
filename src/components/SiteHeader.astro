---
/**
 * Masthead.
 *
 * The demo's header is three things on one row: a wordmark (Chinese + a tiny
 * volume line), a short centre nav, and the live clock beside the 工作 / 时日
 * switch. Here the centre nav keeps the site's own bilingual labels — Chinese
 * over the Greek gloss the old masthead used — so the Greek identity survives
 * at a much smaller size.
 */
import { SITE, UI, withBase } from '../config';

const path = Astro.url.pathname;
const home = withBase('/');

/* `Astro.url.pathname` already carries the base, so compare against prefixed
   hrefs. The home link needs an exact match or it would light up everywhere. */
const isActive = (href: string) => {
	const full = withBase(href);
	return full === home ? path === home : path.startsWith(full);
};
---

<header class="site-header" data-site-header>
	<a class="brand" href={home} aria-label={`${SITE.title}，回到首页`}>
		<span class="brand__name">{SITE.title}</span>
		<span class="brand__sub">{UI.brandSub}</span>
	</a>

	<nav class="site-nav" aria-label="主导航">
		{
			SITE.nav.map((item) => (
				<a
					class:list={['site-nav__link', { 'is-active': isActive(item.href) }]}
					href={withBase(item.href)}
					aria-current={isActive(item.href) ? 'page' : undefined}
				>
					<span class="site-nav__zh">{item.zh}</span>
					<span class="site-nav__el">{item.greek}</span>
				</a>
			))
		}
	</nav>

	<div class="header-tools">
		<span class="header-clock" data-clock>{UI.timeLabel} 00:00</span>

		<button
			class="theme-toggle"
			type="button"
			data-theme-toggle
			aria-pressed="false"
			aria-label="切换到时日模式（关灯）"
			title="开灯 / 关灯"
		>
			<span class="mode-label mode-label--work">工作</span>
			<span class="theme-orb" aria-hidden="true">
				<svg class="orb-sun" viewBox="0 0 24 24">
					<circle cx="12" cy="12" r="3.7"></circle>
					<path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4L17 7M7 17l-1.6 1.6"
					></path>
				</svg>
				<svg class="orb-moon" viewBox="0 0 24 24">
					<path d="M15.2 3.8a8.3 8.3 0 1 0 5 13.3 7 7 0 0 1-5-13.3Z"></path>
				</svg>
			</span>
			<span class="mode-label mode-label--days">时日</span>
		</button>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		inset-block-start: 0;
		z-index: 50;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		min-height: 78px;
		padding-inline: var(--pad);
		background: var(--header-bg);
		border-block-end: 1px solid var(--line);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		transition:
			min-height 0.4s var(--ease),
			background 0.4s ease;
	}

	.site-header.is-compact {
		min-height: 60px;
		background: var(--header-bg-solid);
	}

	/* --- Wordmark --------------------------------------------------------- */

	.brand {
		display: inline-flex;
		flex-direction: column;
		gap: 2px;
		justify-self: start;
		transition: opacity 0.25s ease;
	}

	.brand:hover {
		opacity: 0.72;
	}

	.brand__name {
		font-family: var(--font-serif);
		font-size: clamp(1rem, 0.9rem + 0.28vw, 1.125rem);
		line-height: 1.2;
		letter-spacing: 0.005em;
	}

	.brand__sub {
		color: var(--muted);
		font-size: 0.4375rem;
		letter-spacing: 0.17em;
		line-height: 1.2;
		text-transform: uppercase;
	}

	/* --- Nav -------------------------------------------------------------- */

	.site-nav {
		display: flex;
		gap: clamp(16px, 2.4vw, 36px);
		justify-self: center;
	}

	.site-nav__link {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1px;
		padding-block: 6px;
		color: var(--muted);
		transition: color 0.25s ease;
	}

	.site-nav__zh {
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		line-height: 1.3;
		white-space: nowrap;
	}

	.site-nav__el {
		font-family: var(--font-serif);
		font-size: 0.5rem;
		letter-spacing: 0.06em;
		line-height: 1.2;
		opacity: 0.8;
		white-space: nowrap;
	}

	.site-nav__link::after {
		position: absolute;
		inset-inline: 0;
		inset-block-end: 0;
		height: 1px;
		content: '';
		background: var(--ink);
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 0.35s var(--ease);
	}

	.site-nav__link:hover,
	.site-nav__link.is-active {
		color: var(--ink);
	}

	.site-nav__link:hover::after,
	.site-nav__link.is-active::after {
		transform: scaleX(1);
		transform-origin: left;
	}

	/* --- Tools: clock + 工作 / 时日 ---------------------------------------- */

	.header-tools {
		display: flex;
		align-items: center;
		gap: 18px;
		justify-self: end;
	}

	.header-clock {
		color: var(--muted);
		font-size: 0.5625rem;
		letter-spacing: 0.08em;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.theme-toggle {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		padding: 5px 9px;
		color: var(--muted);
		font-size: 0.5rem;
		letter-spacing: 0.08em;
		white-space: nowrap;
		border: 1px solid var(--line);
		border-radius: 999px;
		transition:
			color 0.25s ease,
			background 0.25s ease,
			border-color 0.25s ease;
	}

	.theme-toggle:hover {
		color: var(--ink);
		background: var(--paper-soft);
		border-color: var(--line-strong);
	}

	.mode-label {
		opacity: 0.45;
		transition:
			color 0.35s ease,
			opacity 0.35s ease;
	}

	.mode-label--work {
		color: var(--ink);
		opacity: 1;
	}

	:global(html[data-theme='night']) .mode-label--work {
		color: var(--muted);
		opacity: 0.45;
	}

	:global(html[data-theme='night']) .mode-label--days {
		color: var(--ink);
		opacity: 1;
	}

	.theme-orb {
		position: relative;
		display: block;
		width: 16px;
		height: 16px;
		flex: none;
	}

	.theme-orb svg {
		position: absolute;
		inset: 0;
		width: 16px;
		height: 16px;
		fill: none;
		stroke: var(--accent);
		stroke-width: 1.25;
		stroke-linecap: round;
		transition:
			opacity 0.45s ease,
			transform 0.65s var(--ease);
	}

	.orb-sun {
		opacity: 1;
		transform: rotate(0deg) scale(1);
	}

	.orb-moon {
		opacity: 0;
		transform: rotate(-35deg) scale(0.6);
	}

	:global(html[data-theme='night']) .orb-sun {
		opacity: 0;
		transform: rotate(55deg) scale(0.5);
	}

	:global(html[data-theme='night']) .orb-moon {
		opacity: 1;
		transform: rotate(0deg) scale(1);
	}

	/* --- Narrow screens --------------------------------------------------- */

	@media (max-width: 64rem) {
		.header-clock {
			display: none;
		}
	}

	@media (max-width: 48rem) {
		.site-header {
			grid-template-areas:
				'brand tools'
				'nav nav';
			grid-template-columns: 1fr auto;
			min-height: 0;
			padding-block: 12px 0;
		}

		.brand {
			grid-area: brand;
		}

		.header-tools {
			grid-area: tools;
		}

		.site-nav {
			grid-area: nav;
			justify-content: space-between;
			gap: 8px;
			width: 100%;
			margin-block-start: 10px;
			padding-block: 9px;
			border-block-start: 1px solid var(--line);
		}

		.site-nav__link {
			flex: 1 1 0;
		}
	}

	@media (max-width: 26rem) {
		.brand__sub {
			display: none;
		}

		.site-nav__el {
			display: none;
		}
	}
</style>
