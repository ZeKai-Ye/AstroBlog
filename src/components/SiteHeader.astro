---
/**
 * Masthead.
 *
 * The wordmark is set in type — Ἔργα καὶ Ἡμέραι over the Chinese/English
 * subtitle — rather than using the painted 960×181 plate from settings.json.
 * At 30–40px the painting stopped being a wordmark: its brush strokes blurred
 * into a smudge, and its cream ground became a lit rectangle in night mode.
 * The painting still opens the 关于 page at its own size.
 */
import { SITE, UI, withBase } from '../config';

const path = Astro.url.pathname;
const home = withBase('/');

/* `Astro.url.pathname` already carries the base, so compare against prefixed
   hrefs. The home link needs an exact match or it would light up everywhere. */
const isActive = (href: string) => {
	const full = withBase(href);
	return full === home ? path === home : path.startsWith(full);
};
---

<header class="site-header" data-site-header>
	<a class="brand" href={home} aria-label={`${SITE.title}，回到首页`}>
		<span class="brand__name" lang="el">{UI.heroGreek}</span>
		<span class="brand__sub">{UI.brandSub}</span>
	</a>

	<nav class="site-nav" id="site-nav" aria-label="主导航">
		{
			SITE.nav.map((item) => (
				<a
					class:list={['site-nav__link', { 'is-active': isActive(item.href) }]}
					href={withBase(item.href)}
					aria-current={isActive(item.href) ? 'page' : undefined}
				>
					<span class="site-nav__zh">{item.zh}</span>
					<span class="site-nav__el" lang="el">
						{item.greek}
					</span>
				</a>
			))
		}
		<a class="site-nav__link site-nav__link--panel" href={withBase('/search/')}>
			<span class="site-nav__zh">搜索</span>
			<span class="site-nav__el">Search</span>
		</a>
	</nav>

	<div class="header-tools">
		<span class="header-clock" data-clock>{UI.timeLabel} 00:00</span>

		<a class="header-search" href={withBase('/search/')} aria-label="搜索文章">
			<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
				<circle cx="10.5" cy="10.5" r="7" stroke="currentColor" stroke-width="1.4"></circle>
				<path d="M15.6 15.6 21 21" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"
				></path>
			</svg>
		</a>

		<button
			class="theme-toggle"
			type="button"
			data-theme-toggle
			aria-pressed="false"
			aria-label="生活版"
			title="翻到生活版（熄灯）"
		>
			<span class="mode-label mode-label--work">工作版</span>
			<span class="theme-orb" aria-hidden="true">
				<svg class="orb-sun" viewBox="0 0 24 24">
					<circle cx="12" cy="12" r="3.7"></circle>
					<path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4L17 7M7 17l-1.6 1.6"
					></path>
				</svg>
				<svg class="orb-moon" viewBox="0 0 24 24">
					<path d="M15.2 3.8a8.3 8.3 0 1 0 5 13.3 7 7 0 0 1-5-13.3Z"></path>
				</svg>
			</span>
			<span class="mode-label mode-label--days">生活版</span>
		</button>

		<button
			class="nav-toggle"
			type="button"
			data-nav-toggle
			aria-expanded="false"
			aria-controls="site-nav"
		>
			目录
		</button>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		inset-block-start: 0;
		z-index: 50;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		min-height: 88px;
		padding-inline: var(--pad);
		background: var(--header-bg);
		border-block-end: 1px solid var(--line);
		transition:
			min-height 0.45s var(--ease),
			background 0.4s ease;
	}

	.site-header.is-compact {
		min-height: 68px;
		background: var(--header-bg-solid);
	}

	/* --- Wordmark --------------------------------------------------------- */

	.brand {
		display: inline-flex;
		flex-direction: column;
		gap: 3px;
		justify-self: start;
		transition: opacity 0.25s ease;
	}

	.brand:hover {
		opacity: 0.78;
	}

	.brand__name {
		font-family: var(--font-serif);
		font-size: 1.25rem;
		line-height: 1.2;
		letter-spacing: 0.01em;
		white-space: nowrap;
	}

	.brand__sub {
		color: var(--muted);
		font-size: 0.75rem;
		letter-spacing: 0.16em;
		line-height: 1.2;
		white-space: nowrap;
		text-transform: uppercase;
	}

	/* --- Nav -------------------------------------------------------------- */

	.site-nav {
		display: flex;
		gap: clamp(18px, 2.6vw, 40px);
		justify-self: center;
	}

	.site-nav__link {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2px;
		padding-block: 7px;
		color: var(--muted);
		transition: color 0.25s ease;
	}

	.site-nav__zh {
		font-size: 0.9375rem;
		letter-spacing: 0.08em;
		line-height: 1.3;
		white-space: nowrap;
	}

	.site-nav__el {
		font-family: var(--font-serif);
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		line-height: 1.2;
		white-space: nowrap;
	}

	.site-nav__link::after {
		position: absolute;
		inset-inline: 0;
		inset-block-end: 0;
		height: 1px;
		content: '';
		background: var(--ink);
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 0.4s var(--ease);
	}

	.site-nav__link:hover,
	.site-nav__link.is-active {
		color: var(--ink);
	}

	.site-nav__link:hover::after,
	.site-nav__link.is-active::after {
		transform: scaleX(1);
		transform-origin: left;
	}

	/* Search is a footer link on desktop; it only joins the nav inside the
	   phone panel, so it does not add a fifth masthead item. */
	.site-nav__link--panel {
		display: none;
	}

	/* --- Tools: clock + 工作 / 生活 ---------------------------------------- */

	.header-tools {
		display: flex;
		align-items: center;
		gap: 20px;
		justify-self: end;
	}

	.header-clock {
		color: var(--muted);
		font-size: 0.8125rem;
		letter-spacing: 0.06em;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.header-search {
		display: grid;
		width: 32px;
		height: 32px;
		place-items: center;
		color: var(--muted);
		transition: color 0.25s ease;
	}

	.header-search:hover {
		color: var(--ink);
	}

	.header-search svg {
		width: 18px;
		height: 18px;
	}

	/* The phone-only disclosure that opens the nav panel. */
	.nav-toggle {
		display: none;
		width: 44px;
		height: 44px;
		align-items: center;
		justify-content: center;
		color: var(--muted);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		border: 1px solid var(--line-strong);
		transition:
			color 0.25s ease,
			background 0.25s ease,
			border-color 0.25s ease;
	}

	.nav-toggle:hover,
	.nav-toggle[aria-expanded='true'] {
		color: var(--ink);
		background: color-mix(in srgb, var(--paper-soft) 70%, transparent);
		border-color: var(--ink);
	}

	.theme-toggle {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 36px;
		padding: 7px 12px;
		color: var(--muted);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		white-space: nowrap;
		border: 1px solid var(--line-strong);
		border-radius: 0;
		transition:
			color 0.25s ease,
			background 0.25s ease,
			border-color 0.25s ease;
	}

	.theme-toggle:hover {
		color: var(--ink);
		background: color-mix(in srgb, var(--paper-soft) 70%, transparent);
		border-color: var(--ink);
	}

	.mode-label {
		color: var(--muted);
		transition: color 0.35s ease;
	}

	.mode-label--work {
		color: var(--ink);
	}

	:global(html[data-edition='life']) .mode-label--work {
		color: var(--muted);
	}

	:global(html[data-edition='life']) .mode-label--days {
		color: var(--ink);
	}

	.theme-orb {
		position: relative;
		display: block;
		width: 18px;
		height: 18px;
		flex: none;
	}

	.theme-orb svg {
		position: absolute;
		inset: 0;
		width: 18px;
		height: 18px;
		fill: none;
		stroke: var(--accent);
		stroke-width: 1.3;
		stroke-linecap: round;
		transition:
			opacity 0.45s ease,
			transform 0.7s var(--ease);
	}

	.orb-sun {
		opacity: 1;
		transform: rotate(0deg) scale(1);
	}

	.orb-moon {
		opacity: 0;
		transform: rotate(-35deg) scale(0.6);
	}

	:global(html[data-theme='night']) .orb-sun {
		opacity: 0;
		transform: rotate(55deg) scale(0.5);
	}

	:global(html[data-theme='night']) .orb-moon {
		opacity: 1;
		transform: rotate(0deg) scale(1);
	}

	/* --- Narrow screens --------------------------------------------------- */

	@media (max-width: 64rem) {
		.header-clock {
			display: none;
		}
	}

	@media (max-width: 48rem) {
		.site-header {
			grid-template-areas: 'brand tools';
			grid-template-columns: minmax(0, 1fr) auto;
			/* One row: 44px controls + 18px padding + the rule ≈ 64px. */
			min-height: 63px;
			padding-block: 9px;
		}

		.site-header.is-compact {
			min-height: 63px;
		}

		.brand {
			grid-area: brand;
			min-width: 0;
		}

		.header-tools {
			grid-area: tools;
			gap: 8px;
		}

		.header-clock,
		.header-search {
			display: none;
		}

		/* The icon carries the mode on a phone; the two words would push the
		   masthead past a 360px screen. */
		.mode-label {
			display: none;
		}

		.theme-toggle {
			width: 44px;
			height: 44px;
			min-height: 44px;
			justify-content: center;
			padding: 0;
		}

		.theme-orb,
		.theme-orb svg {
			width: 20px;
			height: 20px;
		}

		.nav-toggle {
			display: inline-flex;
		}

		.site-nav {
			position: absolute;
			inset-block-start: 100%;
			inset-inline: 0;
			display: none;
			width: 100%;
			justify-self: stretch;
			flex-direction: column;
			gap: 0;
			padding: 2px var(--pad) 14px;
			background: var(--header-bg-solid);
			border-block-end: 1px solid var(--line);
			box-shadow: 0 24px 40px rgb(58 42 26 / 0.14);
		}

		:global(html[data-theme='night']) .site-nav {
			box-shadow: 0 24px 40px rgb(0 0 0 / 0.5);
		}

		.site-nav.is-open {
			display: flex;
		}

		.site-nav__link {
			flex-direction: row;
			align-items: baseline;
			justify-content: space-between;
			gap: 16px;
			min-height: 48px;
			padding-block: 12px;
			border-block-end: 1px solid var(--line);
		}

		.site-nav__link:last-child {
			border-block-end: 0;
		}

		.site-nav__link::after {
			display: none;
		}

		.site-nav__link.is-active .site-nav__zh {
			text-decoration: underline;
			text-decoration-thickness: 1px;
			text-underline-offset: 5px;
		}

		.site-nav__link--panel {
			display: flex;
		}
	}

	@media (max-width: 26rem) {
		.site-nav__el {
			display: none;
		}
	}

	/* A 320px screen still has to hold the wordmark, the switch and the menu. */
	@media (max-width: 22rem) {
		.brand__name {
			font-size: 1.05rem;
		}

		.brand__sub {
			font-size: 0.6875rem;
			letter-spacing: 0.12em;
		}
	}
</style>
