---
/**
 * The site's mark — the picture when `settings.json` sets `images.logo`, and the
 * title set as type when it does not.
 *
 * Both the masthead and the footer use this. The mockup draws the slot once, at
 * the top of the frame ("待添加的标题主图标位置"), but the footer reserves the same
 * block at the bottom, so it wants the same mark rather than the title repeated
 * in a second size.
 *
 * The edges are *masked away* rather than drawn. The picture should melt into
 * whatever it is sitting on instead of reading as a rectangle pasted over it —
 * and since the masthead is cream while the footer is tan, a transparent edge is
 * the only treatment that works on both.
 */
import { Image } from 'astro:assets';
import { SITE, asset } from '../config';

interface Props {
	/**
	 * `masthead` is the large top mark, `footer` the smaller repeat, and `about`
	 * fills the 关于 page's narrow right-hand column.
	 */
	size?: 'masthead' | 'footer' | 'about';
	class?: string;
}

const { size = 'masthead', class: className = '' } = Astro.props;
const logo = asset(SITE.images.logo);

const widths = size === 'masthead' ? [480, 960] : [240, 480];
const sizes =
	size === 'masthead' ? '(max-width: 30rem) 80vw, 30rem' : '(max-width: 30rem) 70vw, 20rem';

/*
	Only the masthead is above the fold on every page, and it is the first thing
	anyone sees — so it is the only one that should be fetched eagerly. Making the
	footer and 关于 copies high-priority too would just have them competing with it.
*/
const eager = size === 'masthead';
---

{
	logo ? (
		<Image
			class:list={['mark', 'mark--image', 'feather', `mark--${size}`, className]}
			src={logo}
			/* Often the only content of a link, so the alt is what names it. */
			alt={SITE.title}
			widths={widths}
			sizes={sizes}
			loading={eager ? 'eager' : 'lazy'}
			fetchpriority={eager ? 'high' : undefined}
		/>
	) : (
		<span class:list={['mark', 'mark--text', `mark--${size}`, className]}>{SITE.title}</span>
	)
}

<style>
	.mark {
		display: block;
	}

	/* --- the picture ------------------------------------------------------ */
	.mark--image {
		width: auto;
		max-width: 100%;
		/* The melted edge itself comes from `.feather`, shared with the hero
		   photographs; its --feather-x/y defaults are tuned for a mark. */
	}

	.mark--image.mark--masthead {
		height: clamp(2.5rem, 0.75rem + 4vw, 5rem);
	}

	.mark--image.mark--footer {
		height: clamp(2rem, 0.6rem + 2.8vw, 3.6rem);
	}

	/*
		The 关于 column is narrow and flush right, so this one is driven by width
		instead of height: it fills the column and the height follows the ratio,
		which means it can never overflow the way a fixed height would.
	*/
	.mark--image.mark--about {
		width: 100%;
		height: auto;
	}

	/* --- the type fallback ------------------------------------------------ */
	.mark--text {
		font-weight: 700;
		letter-spacing: 0.06em;
		line-height: 1.2;
		text-align: center;
	}

	.mark--text.mark--masthead {
		font-size: clamp(1.125rem, 0.5rem + 1.45vw, 1.75rem);
	}

	.mark--text.mark--footer {
		font-size: var(--fs-lead);
	}
</style>
