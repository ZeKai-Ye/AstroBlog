---
/**
 * Page shell: the paper sheet, the masthead, the footer.
 *
 * One surface for every page now — the design's warm paper — so there is no
 * `surface` prop any more: night mode (时日) is the only thing that changes the
 * ground, and it does that through `html[data-theme]`.
 */
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BackToTop from '../components/BackToTop.astro';
import { SITE, withBase } from '../config';

interface Props {
	/** Page title; the site name is appended automatically. */
	title?: string;
	description?: string;
}

const { title, description = SITE.description } = Astro.props;

const pageTitle = title ? `${title} — ${SITE.title}` : SITE.title;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#fff1d4" />

		{/*
			Before first paint: gate the reveal animation behind `.js`, and put the
			right theme on <html> so nobody sees the wrong edition flash by.

			The stored preference wins. With no preference at all the page is about
			to follow the sun (site.ts does the exact calculation with suncalc);
			here a rough 06:00–18:00 day is enough to pick the right side before
			the script bundle arrives. Inline and first in <head> because anything
			later is too late.
		*/}
		<script is:inline>
			(() => {
				const root = document.documentElement;
				root.classList.add('js');

				const goNight = () => {
					root.dataset.theme = 'night';
					const meta = document.querySelector('meta[name="theme-color"]');
					if (meta) meta.setAttribute('content', '#171812');
				};

				try {
					const stored = localStorage.getItem('erga-theme');
					if (stored === 'night') {
						goNight();
					} else if (!stored) {
						const hour = Number(
							new Intl.DateTimeFormat('en-GB', {
								timeZone: 'Asia/Shanghai',
								hour: '2-digit',
								hourCycle: 'h23',
							}).format(new Date())
						);
						if (hour < 6 || hour >= 18) goNight();
					}
				} catch (error) {
					/* private mode, storage disabled — keep the paper default */
				}
			})();
		</script>

		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />

		{/*
			Client-side routing with the native View Transitions API. It is what
			makes moving between pages feel like turning a sheet rather than a
			white flash; the site's own scripts re-attach on `astro:page-load`
			(see src/scripts/site.ts) and the 3D scene does the same.
		*/}
		<ClientRouter />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		{canonical && <link rel="canonical" href={canonical.href} />}

		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content={SITE.title} />
		<meta property="og:locale" content="zh_CN" />

		{/*
			The display face is Noto Serif SC, loaded from jsDelivr's Fontsource
			build: the CJK family ships as ~130 unicode-ranged woff2 chunks, so the
			browser downloads only the handful a page uses. 400 carries the titles,
			600 the few places that need a real bold (no synthetic slant). The sans
			face stays on the system stack — the interface only uses it at 9–13px.
		*/}
		<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/npm/@fontsource/noto-serif-sc@5/400.css"
		/>
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/npm/@fontsource/noto-serif-sc@5/600.css"
		/>
	</head>

	<body>
		<a class="skip-link" href="#main">跳到主要内容</a>

		<div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
		<div class="sky-wash" data-sky-wash aria-hidden="true"></div>

		<div class="page">
			<SiteHeader />

			<main id="main">
				<slot />
			</main>

			<SiteFooter />
		</div>

		<BackToTop />

		<script>
			import '../scripts/site';
		</script>
	</body>
</html>
