---
/**
 * 关于 / περί.
 *
 * The mockup only reserves this band and drops the 关于 label into its right
 * half, so the copy below is a placeholder to replace. The 作者一览 grid below
 * it is this site's own addition — one entry per file in src/content/authors,
 * each linking to that author's page and their posts.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WaveBand from '../components/WaveBand.astro';
import AuthorCard from '../components/AuthorCard.astro';
import SiteMark from '../components/SiteMark.astro';
import { SITE, withBase } from '../config';
import { getAuthorIndex, postCounts } from '../authors';

const index = await getAuthorIndex();
const posts = await getCollection('blog', ({ data }) => !data.draft);
const counts = postCounts(posts, index);
---

<BaseLayout title="关于" surface="tan">
	<div class="container intro">
		<h1 class="section-label section-label--peach intro__label">关于</h1>
	</div>

	<WaveBand class="band">
		<div class="container band-inner about">
			<div class="prose about__body">
				<p>
					{SITE.title} 是一个个人站点。这里放三样东西：正在做的工作、读到的和想到的、以及一些没有归类的日子。
				</p>
				<p>
					写作对我来说更像整理——把散落的东西摆到光底下，看清楚它们本来的形状。所以这里的文字偏长，更新也偏慢。
				</p>
				<h2>联系</h2>
				<ul>
					<li>邮箱：<a href="mailto:hello@example.com">hello@example.com</a></li>
					<li>GitHub：<a href="https://github.com/" rel="me noopener">@your-handle</a></li>
				</ul>
				<p class="about__note">以上信息均为占位内容，请替换为你自己的。</p>
			</div>

			<aside class="about__aside">
				<SiteMark size="about" />
				<p class="about__bio">{SITE.description}</p>
			</aside>
		</div>
	</WaveBand>

	<section class="container authors" aria-labelledby="authors-heading">
		<h2 id="authors-heading" class="section-label section-label--rose authors__label">作者一览</h2>

		<ul class="authors__grid">
			{
				index.list.map((author) => (
					<li>
						<AuthorCard
							author={author}
							href={withBase(`/authors/${author.id}/`)}
							note={`${counts.get(author.id) ?? 0} 篇`}
						/>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>

<style>
	.intro {
		padding-block: var(--section-pad);
	}

	.intro__label {
		text-align: center;
	}

	.about {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 16rem;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
	}

	.about__body {
		max-width: 42ch;
	}

	.about__note {
		font-size: var(--fs-meta);
		color: var(--c-ink-muted);
	}

	.about__aside {
		display: grid;
		gap: 0.4rem;
		text-align: end;
	}

	.about__bio {
		font-size: var(--fs-meta);
		color: var(--c-ink-muted);
	}

	/* --- 作者一览 ---------------------------------------------------------- */
	.authors {
		padding-block: var(--section-pad);
	}

	.authors__label {
		margin-block-end: clamp(1.5rem, 3vw, 2.5rem);
	}

	.authors__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: clamp(1.25rem, 3vw, 2rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (max-width: 48rem) {
		.about {
			grid-template-columns: minmax(0, 1fr);
		}

		.about__aside {
			text-align: start;
		}
	}
</style>
