---
/**
 * 作者页 — one author, and everything they wrote here.
 *
 * Same paper furniture as the 关于 page: a page head, a square avatar, the bio,
 * then the author's ledger. The back link returns to the 作者一览 grid.
 */
import { getCollection, render } from 'astro:content';
import 'katex/dist/katex.min.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Figure from '../../components/Figure.astro';
import PostRow from '../../components/PostRow.astro';
import { asset, withBase } from '../../config';
import { authorOf, getAuthorIndex, type Author, type Post } from '../../authors';

export async function getStaticPaths() {
	const index = await getAuthorIndex();
	const posts = await getCollection('blog', ({ data }) => !data.draft);

	return index.list.map((author) => ({
		params: { id: author.id },
		props: {
			author,
			posts: posts
				.filter((post) => authorOf(index, post.data.author)?.id === author.id)
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

interface Props {
	author: Author;
	posts: Post[];
}

const { author, posts } = Astro.props;
const { data } = author;
const { Content } = await render(author);
const avatar = asset(data.avatar);
---

<BaseLayout title={data.name} description={data.bio}>
	<div class="container page-head">
		<a class="author__back" href={`${withBase('/about/')}#authors-heading`}>← 作者一览</a>

		<div class="author__hero">
			<div class="author__avatar">
				<Figure
					src={avatar}
					alt={`${data.name} 的头像`}
					label="头像"
					ratio="1 / 1"
					sizes="(max-width: 48rem) 40vw, 12rem"
				/>
			</div>

			<div class="author__text">
				<p class="section-kicker">{data.role || 'Author / 作者'}</p>
				<h1 class="author__name">{data.name}</h1>
				{data.bio && <p class="author__bio">{data.bio}</p>}

				{
					data.links.length > 0 && (
						<ul class="author__links">
							{data.links.map((link) => (
								<li>
									<a href={link.href} rel="me noopener">
										{link.label}
									</a>
								</li>
							))}
						</ul>
					)
				}
			</div>
		</div>
	</div>

	{
		author.body?.trim() && (
			<div class="container">
				<div class="prose author__intro">
					<Content />
				</div>
			</div>
		)
	}

	<section class="container author__posts" aria-labelledby="author-posts">
		<header class="section-head">
			<div>
				<p class="section-kicker">Writing / 文章</p>
				<h2 class="section-title" id="author-posts">写的文章。</h2>
			</div>
			<p class="section-note">{posts.length} 篇</p>
		</header>

		{
			posts.length > 0 ? (
				<ol class="rows">
					{posts.map((post, index) => (
						<PostRow post={post} index={index} />
					))}
				</ol>
			) : (
				<p class="author__empty">还没有署名的文章。</p>
			)
		}
	</section>
</BaseLayout>
<style>
	.author__back {
		color: var(--muted);
		font-size: 0.75rem;
		letter-spacing: 0.09em;
		transition: color 0.25s ease;
	}

	.author__back:hover {
		color: var(--accent);
	}

	.author__hero {
		display: grid;
		grid-template-columns: clamp(6rem, 12vw, 9rem) minmax(0, 1fr);
		gap: clamp(24px, 4vw, 48px);
		align-items: start;
		margin-block-start: clamp(30px, 4vw, 44px);
	}

	.author__name {
		margin-block-start: 14px;
		font-family: var(--font-serif);
		font-size: clamp(2.2rem, 4.8vw, 4rem);
		font-weight: 400;
		line-height: 1.12;
		letter-spacing: -0.055em;
	}

	.author__bio {
		max-width: 34rem;
		margin-block-start: 16px;
		color: var(--ink-soft);
		font-family: var(--font-serif);
		font-size: 1.0625rem;
		line-height: 1.85;
	}

	.author__links {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 20px;
		margin-block-start: 20px;
		color: var(--muted);
		font-size: 0.8125rem;
		letter-spacing: 0.04em;
	}

	.author__links a {
		padding-block-end: 4px;
		border-block-end: 1px solid var(--line-strong);
		transition:
			color 0.25s ease,
			border-color 0.25s ease;
	}

	.author__links a:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	.author__intro {
		max-width: 40rem;
		padding-block-start: clamp(30px, 4vw, 48px);
	}

	.author__posts {
		padding-block: var(--section-pad);
	}

	.author__empty {
		color: var(--muted);
		font-size: 0.8125rem;
	}

	@media (max-width: 48rem) {
		.author__hero {
			grid-template-columns: minmax(0, 1fr);
			gap: 22px;
		}

		.author__avatar {
			max-width: 8rem;
		}
	}
</style>
