---
/**
 * Post page — frame 2 of `ui设计.free`.
 *
 * The mockup is a 1920x4320 sheet on the #FCF4E3 fill (the masthead becomes a
 * translucent cream plate, CCFFF1D4). Below it sits a two-column grid:
 *
 *   left   x    0–1382   the article: a meta row at y 456–596 — a stacked
 *                        3-line date, a 1px vertical rule, then the title —
 *                        and the body (mocked up as a grey block labelled 正文)
 *   right  x 1440–1888   a 448px sidebar: the search field at y 478–574, then
 *                        the author card at y 689–1324
 *
 * Everything is scaled into the site's 1280px column with the sidebar held at
 * the same 24% share; the mockup's grey body block carries the real article.
 */
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import Figure from '../../components/Figure.astro';
import SearchBox from '../../components/SearchBox.astro';
import { SITE, formatDateParts, withBase, asset } from '../../config';
import { getAuthorIndex, authorOf } from '../../authors';

export async function getStaticPaths() {
	const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
		(a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
	);

	return posts.map((entry, index) => ({
		params: { slug: entry.id },
		props: {
			entry,
			prev: posts[index - 1] ?? null,
			next: posts[index + 1] ?? null,
		},
	}));
}

interface Props {
	entry: CollectionEntry<'blog'>;
	prev: CollectionEntry<'blog'> | null;
	next: CollectionEntry<'blog'> | null;
}

const { entry, prev, next } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

/* The card in the sidebar is whoever this post is by, linked to their page. */
const author = authorOf(await getAuthorIndex(), data.author);
const authorHref = author ? withBase(`/authors/${author.id}/`) : undefined;

const date = formatDateParts(data.pubDate);
const updated = data.updatedDate ? formatDateParts(data.updatedDate) : null;
---

<BaseLayout title={data.title} description={data.description} surface="cream">
	<div class="container post">
		<!-- Meta row: stacked date | rule | title. -->
		<header class="post__meta">
			<time class="post__date" datetime={date.iso}>
				<span>{date.year}</span>
				<span>{date.month}</span>
				<span>{date.day}</span>
			</time>

			<span class="post__rule" aria-hidden="true"></span>

			<div class="post__heading">
				<h1 class="post__title">{data.title}</h1>
				{data.description && <p class="post__lede">{data.description}</p>}
			</div>
		</header>

		<!-- Sidebar, first row: search. -->
		<div class="post__search">
			<SearchBox />
		</div>

		<!-- Article body. -->
		<article class="prose post__body">
			{
				data.cover && (
					<div class="post__cover">
						<Figure
							src={asset(data.cover)}
							alt={data.coverAlt || data.title}
							ratio="16 / 9"
							sizes="(max-width: 56rem) 100vw, 60rem"
						/>
					</div>
				)
			}

			<Content />

			{
				data.tags.length > 0 && (
					<ul class="post__tags">
						{data.tags.map((tag) => (
							<li>{tag}</li>
						))}
					</ul>
				)
			}

			{
				updated && (
					<p class="post__updated">
						修订于 <time datetime={updated.iso}>{updated.iso}</time>
					</p>
				)
			}
		</article>

		<!-- Sidebar, second row: author. -->
		<div class="post__aside">
			<AuthorCard author={author} href={authorHref} />
		</div>
	</div>

	<!-- Neighbour links, using the same hairline rows as 推荐 on the home page. -->
	<nav class="container post__nav" aria-label="上下篇">
		<ul class="post__nav-list">
			{
				prev && (
					<li class="post__nav-item">
						<a href={withBase(`/blog/${prev.id}/`)}>
							<span class="post__nav-dir">上一篇</span>
							<span class="post__nav-title">{prev.data.title}</span>
						</a>
					</li>
				)
			}
			{
				next && (
					<li class="post__nav-item post__nav-item--next">
						<a href={withBase(`/blog/${next.id}/`)}>
							<span class="post__nav-dir">下一篇</span>
							<span class="post__nav-title">{next.data.title}</span>
						</a>
					</li>
				)
			}
		</ul>
	</nav>
</BaseLayout>

<style>
	.post {
		display: grid;
		/* Sidebar is 23.7% of the mockup's 1888px content span. */
		grid-template-columns: minmax(0, 1fr) 20rem;
		column-gap: clamp(2rem, 4vw, 3.5rem);
		row-gap: clamp(2rem, 3vw, 3rem);
		padding-block: var(--section-pad) 0;
	}

	/* --- Meta row --------------------------------------------------------- */
	.post__meta {
		grid-column: 1;
		display: grid;
		grid-template-columns: auto 1px minmax(0, 1fr);
		gap: clamp(1.25rem, 3vw, 2.5rem);
		align-items: center;
	}

	/* 275px wide in the mockup, three centred lines at the 36px lead size. */
	.post__date {
		display: grid;
		justify-items: center;
		min-width: 6.5em;
		font-size: var(--fs-lead);
		line-height: 1.25;
		font-variant-numeric: tabular-nums;
	}

	/* 1px x 140px vertical rule between the date and the title. */
	.post__rule {
		align-self: stretch;
		background: var(--c-divider);
	}

	.post__heading {
		display: grid;
		gap: 0.6em;
		text-align: center;
	}

	.post__title {
		font-size: var(--fs-lead);
		font-weight: 700;
		line-height: 1.3;
	}

	.post__lede {
		font-size: var(--fs-meta);
		line-height: 1.6;
		color: var(--c-ink-muted);
	}

	/* --- Body + sidebar --------------------------------------------------- */
	.post__body {
		grid-column: 1;
		min-width: 0;
	}

	.post__cover {
		margin-block-end: 1.6em;
	}

	.post__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-block-start: 2.5em;
		padding: 0;
		list-style: none;
		font-size: var(--fs-meta);
		color: var(--c-ink-muted);
	}

	.post__tags li::before {
		content: '#';
		margin-inline-end: 0.15em;
	}

	.post__updated {
		margin-block-start: 1.2em;
		font-size: var(--fs-meta);
		color: var(--c-ink-muted);
	}

	.post__search,
	.post__aside {
		grid-column: 2;
	}

	/* --- Prev / next ------------------------------------------------------ */
	.post__nav {
		padding-block: var(--section-pad);
	}

	.post__nav-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.post__nav-item {
		border-block-start: 1px solid var(--c-divider);
	}

	.post__nav-item--next a {
		text-align: end;
	}

	.post__nav-item a {
		display: grid;
		gap: 0.3em;
		padding-block: 1.15rem;
		transition: opacity 0.2s var(--ease);
	}

	.post__nav-item a:hover {
		opacity: 0.6;
	}

	.post__nav-dir {
		font-size: var(--fs-meta);
		color: var(--c-ink-muted);
	}

	.post__nav-title {
		font-size: var(--fs-lead);
		line-height: 1.3;
	}

	/* --- Narrow screens --------------------------------------------------- */
	@media (max-width: 56rem) {
		.post {
			grid-template-columns: minmax(0, 1fr);
		}

		.post__meta,
		.post__body,
		.post__search,
		.post__aside {
			grid-column: 1;
		}

		/* Search sits under the meta row; the author card closes the page. */
		.post__search {
			order: 1;
		}

		.post__body {
			order: 2;
		}

		.post__aside {
			order: 3;
		}

		.post__meta {
			grid-template-columns: 1fr;
			justify-items: center;
			gap: 1.5rem;
		}

		.post__rule {
			display: none;
		}

		.post__date {
			grid-auto-flow: column;
			gap: 0.6em;
		}
	}

	@media (max-width: 40rem) {
		.post__nav-list {
			grid-template-columns: minmax(0, 1fr);
		}

		.post__nav-item--next a {
			text-align: start;
		}
	}
</style>
