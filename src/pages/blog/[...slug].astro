---
/**
 * A single post.
 *
 * The reading column follows the demo's reading sheet: a small meta line, an
 * oversized serif title, a lede hung on an accent rule, then body copy set in
 * the serif face at a comfortable measure. The sidebar keeps this site's own
 * furniture — the author card and the search field — and goes away below 62rem.
 */
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import 'katex/dist/katex.min.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import Figure from '../../components/Figure.astro';
import SearchBox from '../../components/SearchBox.astro';
import {
	SITE,
	asset,
	categoryOf,
	formatDateDot,
	isoDate,
	readingMinutes,
	withBase,
} from '../../config';
import { authorOf, getAuthorIndex } from '../../authors';

export async function getStaticPaths() {
	const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
		(a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf(),
	);

	return posts.map((entry, index) => ({
		params: { slug: entry.id },
		props: {
			entry,
			prev: posts[index - 1] ?? null,
			next: posts[index + 1] ?? null,
		},
	}));
}

interface Props {
	entry: CollectionEntry<'blog'>;
	prev: CollectionEntry<'blog'> | null;
	next: CollectionEntry<'blog'> | null;
}

const { entry, prev, next } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

/* The sidebar card is whoever this post is by, linked to their page. */
const author = authorOf(await getAuthorIndex(), data.author);
const authorHref = author ? withBase(`/authors/${author.id}/`) : undefined;

const cover = asset(data.cover);
const minutes = readingMinutes(entry.body);
---

<BaseLayout title={data.title} description={data.description}>
	<article class="container post">
		<header class="post__head">
			<div class="post__bar">
				<a class="post__back" href={withBase('/blog/')}>
					<span aria-hidden="true">←</span> 时日
				</a>

				<p class="meta-line post__meta">
					<span class="post__category">{categoryOf(entry)}</span>
					<time datetime={isoDate(data.pubDate)}>{formatDateDot(data.pubDate)}</time>
					<span>{minutes} 分钟阅读</span>
				</p>
			</div>

			<h1 class="post__title">{data.title}</h1>

			{data.description && <p class="post__lede">{data.description}</p>}

			<p class="meta-line post__byline">
				<span>文 / {author?.data.name ?? SITE.author.name}</span>
				{data.updatedDate && (
					<span>修订于 {formatDateDot(data.updatedDate)}</span>
				)}
			</p>
		</header>

		{
			cover && (
				<div class="post__cover">
					<Figure
						src={cover}
						alt={data.coverAlt || data.title}
						label="题图"
						ratio="16 / 9"
						sizes="(max-width: 80rem) 100vw, 1280px"
					/>
				</div>
			)
		}

		<div class="post__grid">
			<div class="post__main">
				<div class="prose post__body">
					<Content />
				</div>

				{
					data.tags.length > 0 && (
						<ul class="post__tags">
							{data.tags.map((tag) => (
								<li>
									<a
										href={`${withBase('/search/')}?q=${encodeURIComponent(tag)}`}
									>
										#{tag}
									</a>
								</li>
							))}
						</ul>
					)
				}
			</div>

			<aside class="post__aside">
				<AuthorCard author={author} href={authorHref} />
				<div class="post__search">
					<SearchBox />
				</div>
			</aside>
		</div>
	</article>

	<nav class="container post__nav" aria-label="上下篇">
		<ul class="post__nav-list">
			{
				prev ? (
					<li class="post__nav-item">
						<a href={withBase(`/blog/${prev.id}/`)}>
							<span class="post__nav-dir">← 上一篇</span>
							<span class="post__nav-title">{prev.data.title}</span>
						</a>
					</li>
				) : (
					<li class="post__nav-item post__nav-item--empty" aria-hidden="true"></li>
				)
			}
			{
				next && (
					<li class="post__nav-item post__nav-item--next">
						<a href={withBase(`/blog/${next.id}/`)}>
							<span class="post__nav-dir">下一篇 →</span>
							<span class="post__nav-title">{next.data.title}</span>
						</a>
					</li>
				)
			}
		</ul>
	</nav>
</BaseLayout>

<style>
	.post {
		padding-block-start: clamp(34px, 4.5vw, 56px);
	}

	/* --- Head ------------------------------------------------------------- */

	.post__bar {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px 24px;
		padding-block-end: 26px;
		border-block-end: 1px solid var(--line);
	}

	.post__back {
		color: var(--muted);
		font-size: 0.6875rem;
		letter-spacing: 0.09em;
		transition: color 0.25s ease;
	}

	.post__back:hover {
		color: var(--accent);
	}

	.post__category {
		color: var(--accent);
		font-size: 0.6875rem;
		letter-spacing: 0.1em;
	}

	.post__title {
		max-width: 22ch;
		margin-block-start: clamp(30px, 4vw, 46px);
		font-family: var(--font-serif);
		font-size: clamp(2.1rem, 4.6vw, 3.9rem);
		font-weight: 400;
		line-height: 1.18;
		letter-spacing: -0.055em;
	}

	.post__lede {
		max-width: 38rem;
		margin-block-start: clamp(22px, 2.6vw, 30px);
		padding-inline-start: 20px;
		color: var(--ink-soft);
		font-family: var(--font-serif);
		font-size: clamp(1.02rem, 1.35vw, 1.25rem);
		line-height: 1.85;
		border-inline-start: 1px solid var(--accent);
	}

	.post__byline {
		margin-block-start: 24px;
	}

		/* --- Cover ------------------------------------------------------------ */

	.post__cover {
		margin-block-start: clamp(30px, 3.6vw, 46px);
	}

	/* --- Body + aside ----------------------------------------------------- */

	.post__grid {
		display: grid;
		grid-template-columns: minmax(0, var(--measure)) minmax(12rem, 16rem);
		justify-content: space-between;
		gap: clamp(40px, 6vw, 84px);
		padding-block-start: clamp(38px, 4.6vw, 58px);
	}

	.post__main {
		min-width: 0;
	}

	.post__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 16px;
		margin-block-start: clamp(36px, 4vw, 52px);
		padding-block-start: 16px;
		color: var(--muted);
		font-size: 0.6875rem;
		letter-spacing: 0.04em;
		border-block-start: 1px solid var(--line);
	}

	.post__tags a {
		transition: color 0.2s ease;
	}

	.post__tags a:hover {
		color: var(--accent);
	}

	.post__aside {
		position: sticky;
		inset-block-start: 112px;
		display: grid;
		gap: 26px;
		align-content: start;
	}

	/* --- Prev / next ------------------------------------------------------ */

	.post__nav {
		padding-block: clamp(40px, 5vw, 64px) var(--section-pad);
	}

	.post__nav-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		border-block-start: 1px solid var(--line-strong);
	}

	.post__nav-item + .post__nav-item {
		border-inline-start: 1px solid var(--line);
	}

	.post__nav-item a {
		display: grid;
		gap: 6px;
		padding: 18px 0;
		transition: color 0.25s ease;
	}

	.post__nav-item + .post__nav-item a {
		padding-inline-start: clamp(18px, 2.5vw, 30px);
	}

	.post__nav-item--next a {
		text-align: end;
	}

	.post__nav-item a:hover {
		color: var(--accent);
	}

	.post__nav-dir {
		color: var(--muted);
		font-size: 0.5625rem;
		letter-spacing: 0.1em;
	}

	.post__nav-title {
		font-family: var(--font-serif);
		font-size: 1.0625rem;
		line-height: 1.45;
		letter-spacing: -0.02em;
	}

	@media (max-width: 62rem) {
		.post__grid {
			grid-template-columns: minmax(0, 1fr);
			gap: 44px;
		}

		.post__aside {
			position: static;
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: 20px;
			align-items: start;
		}
	}

	@media (max-width: 48rem) {
		.post__title {
			max-width: none;
			font-size: clamp(1.9rem, 8.4vw, 2.6rem);
		}

		.post__aside {
			grid-template-columns: minmax(0, 1fr);
		}

		.post__nav-list {
			grid-template-columns: minmax(0, 1fr);
		}

		.post__nav-item + .post__nav-item {
			border-inline-start: 0;
			border-block-start: 1px solid var(--line);
		}

		.post__nav-item + .post__nav-item a {
			padding-inline-start: 0;
		}

		.post__nav-item--next a {
			text-align: start;
		}
	}
</style>
