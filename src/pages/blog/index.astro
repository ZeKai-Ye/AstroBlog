---
/**
 * 时日 — the blog index.
 *
 * The demo's 时日 section is a vertical timeline rather than a table of rows, so
 * the index reads as a ledger of days: date on the left, the entry in the
 * middle, its category on the right. The left column carries a live 此刻 card
 * (the demo's Now panel, filled with the clock instead of invented copy) and the
 * tag list, which links into the search page.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Figure from '../../components/Figure.astro';
import { SITE, asset, categoryOf, formatMonthDay, isoDate, withBase } from '../../config';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

/* The 时日 photograph configured in settings.json: a print on the page head. */
const banner = asset(SITE.images.heroDays);

const tagCounts = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.data.tags) {
		tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
	}
}
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="时日" description={`${SITE.title} 的全部文章，共 ${posts.length} 篇。`}>
	<header class="container page-head page-head--lined page-head--split">
		<div class="page-head__text">
			<p class="section-kicker">02 — Days / 时日</p>
			<h1 class="page-head__title">一些很小的日子。</h1>
			<p class="page-head__lede">
				共 {posts.length} 篇，从最近的开始。想找某个主题，可以直接
				<a href={withBase('/search/')}>搜索</a>，或者点左边任意一个标签。
			</p>
		</div>

		{
			banner && (
				<figure class="print print--banner" style="--print-tilt: 1.8deg">
					<Figure
						src={banner}
						alt="时日：一小片天空与树"
						label="时日"
						ratio="4 / 3"
						sizes="(max-width: 62rem) 80vw, 20rem"
					/>
					<figcaption class="print__caption">
						<span>时日 / Hēmerai</span><span>DAYS</span>
					</figcaption>
				</figure>
			)
		}
	</header>

	<div class="container days">
		<aside class="days__side" data-reveal>
			<div class="now">
				<p class="now__label">Now / 此刻</p>
				<dl class="now__list">
					<div><dt>日期</dt><dd data-now-date>—</dd></div>
					<div><dt>时刻</dt><dd data-clock-time>00:00</dd></div>
					<div><dt>一天已过</dt><dd data-now-progress>0%</dd></div>
					<div><dt>篇目</dt><dd>{posts.length}</dd></div>
				</dl>
			</div>

			{
				tags.length > 0 && (
					<div class="tag-list">
						<p class="now__label">Tags / 标签</p>
						<ul class="tag-list__items">
							{tags.map(([tag, count]) => (
								<li>
									<a href={`${withBase('/search/')}?q=${encodeURIComponent(tag)}`}>
										<span>{tag}</span>
										<span class="tag-list__count">{count}</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				)
			}

			<a class="text-link days__search" href={withBase('/search/')}>
				搜索全部 <span class="text-link__arrow">↗</span>
			</a>
		</aside>

		{
			posts.length > 0 ? (
				<ol class="timeline" data-reveal style="--reveal-delay:100ms">
					{posts.map((post) => (
						<li class="day">
							<time class="day__date" datetime={isoDate(post.data.pubDate)}>
								{formatMonthDay(post.data.pubDate)}
							</time>

							<div class="day__body">
								<a class="day__title" href={withBase(`/blog/${post.id}/`)}>
									{post.data.title}
								</a>
								{post.data.description && (
									<p class="day__desc">{post.data.description}</p>
								)}
							</div>

							<span class="day__tag">{categoryOf(post)}</span>
						</li>
					))}
				</ol>
			) : (
				<p class="days__empty">
					还没有文章。把 Markdown 放进 <code>src/content/blog</code> 即可。
				</p>
			)
		}
	</div>

	<p class="container days__note">
		这里按日期倒序排列。每一行都是单独的一页，点进去就是全文。
	</p>
</BaseLayout>

<style>
	.days {
		display: grid;
		grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
		gap: clamp(42px, 7vw, 118px);
		align-items: start;
	}

	.days__side {
		position: sticky;
		inset-block-start: 112px;
	}

	.now {
		padding-block-start: 20px;
		border-block-start: 1px solid var(--line-strong);
	}

	.now__label {
		color: var(--accent);
		font-size: 0.6875rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.now__list {
		margin-block-start: 14px;
	}

	.now__list div {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 18px;
		padding-block: 10px;
		border-block-end: 1px solid var(--line);
	}

	.now__list dt {
		color: var(--muted);
		font-size: 0.6875rem;
		letter-spacing: 0.08em;
	}

	.now__list dd {
		font-family: var(--font-serif);
		font-size: 0.9375rem;
		text-align: right;
		font-variant-numeric: tabular-nums;
	}

	.tag-list {
		margin-block-start: 38px;
	}

	.tag-list__items {
		margin-block-start: 12px;
	}

	.tag-list__items a {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 14px;
		padding-block: 7px;
		color: var(--muted);
		font-size: 0.8125rem;
		letter-spacing: 0.04em;
		transition: color 0.2s ease;
	}

	.tag-list__items a:hover {
		color: var(--ink);
	}

	.tag-list__count {
		color: var(--muted-soft);
		font-size: 0.6875rem;
		font-variant-numeric: tabular-nums;
	}

	.days__search {
		margin-block-start: 28px;
	}

	/* --- Timeline --------------------------------------------------------- */

	.timeline {
		position: relative;
		padding-inline-start: 34px;
	}

	.timeline::before {
		position: absolute;
		inset-block: 0;
		inset-inline-start: 5px;
		width: 1px;
		content: '';
		background: var(--line-strong);
		transform-origin: top;
	}

	:global(html.js) .timeline::before {
		transform: scaleY(0);
		transition: transform 1.6s var(--ease) 0.15s;
	}

	:global(html.js) .timeline.is-visible::before {
		transform: scaleY(1);
	}

	.day {
		position: relative;
		display: grid;
		grid-template-columns: 3.4rem minmax(0, 1fr) auto;
		gap: 17px;
		align-items: baseline;
		padding-block-end: 30px;
	}

	.day:last-child {
		padding-block-end: 0;
	}

	.day::before {
		position: absolute;
		inset-block-start: 7px;
		inset-inline-start: -33px;
		width: 7px;
		height: 7px;
		content: '';
		background: var(--bg);
		border: 1px solid var(--line-strong);
		border-radius: 50%;
		transition:
			background 0.3s ease,
			border-color 0.3s ease;
	}

	.day:hover::before {
		background: var(--accent);
		border-color: var(--accent);
	}

	.day__date {
		color: var(--accent);
		font-family: var(--font-serif);
		font-size: 0.84375rem;
		letter-spacing: 0.02em;
	}

	.day__title {
		font-family: var(--font-serif);
		font-size: clamp(1.1rem, 1.6vw, 1.4rem);
		line-height: 1.45;
		letter-spacing: -0.025em;
		transition: color 0.25s ease;
	}

	.day__title:hover {
		color: var(--accent);
	}

	.day__desc {
		max-width: 33rem;
		margin-block-start: 6px;
		color: var(--muted);
		font-size: 0.84375rem;
		line-height: 1.85;
	}

	.day__tag {
		color: var(--muted);
		font-size: 0.6875rem;
		letter-spacing: 0.08em;
	}

	.days__empty,
	.days__note {
		color: var(--muted);
		font-size: 0.8125rem;
		line-height: 1.9;
	}

	.days__note {
		padding-block: var(--section-pad);
	}

	@media (max-width: 62rem) {
		.days {
			grid-template-columns: 1fr;
			gap: 44px;
		}

		/* On a phone the list is the reason for the page, so it comes first and
		   the Now card / tags follow it. */
		.timeline {
			order: 1;
		}

		.days__side {
			order: 2;
			position: static;
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
			gap: 26px;
			align-items: start;
		}

		.now {
			padding-block-start: 16px;
		}

		.tag-list {
			margin-block-start: 16px;
		}

		.days__search {
			margin-block-start: 16px;
			align-self: end;
		}
	}

	@media (max-width: 48rem) {
		.tag-list__items {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0 22px;
		}

		.timeline {
			padding-inline-start: 25px;
		}

		.timeline::before {
			inset-inline-start: 3px;
		}

		.day {
			grid-template-columns: 2.9rem minmax(0, 1fr);
			gap: 12px;
			padding-block-end: 26px;
		}

		.day::before {
			inset-inline-start: -25px;
		}

		.day__tag {
			grid-column: 2;
			margin-block-start: -2px;
			font-size: 0.6875rem;
		}
	}
</style>
