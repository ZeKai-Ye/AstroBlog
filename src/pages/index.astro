---
/**
 * Home — the paper edition.
 *
 * Composition, top to bottom:
 *
 *   hero      huge serif headline, the live 日晷, and a dot-leader contents row
 *   latest    the newest post as an editorial feature, art on the right
 *   writing   the ledger of recent posts, with a hover preview panel
 *   work      three archive cards from `settings.json`
 *   about     the site's own introduction, counts and a photograph
 *
 * The hero headline and a few short lines are design copy; the rest is real
 * content — posts, work entries, authors — so the page empties gracefully
 * instead of showing placeholders.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Figure from '../components/Figure.astro';
import PostRow from '../components/PostRow.astro';
import Sundial from '../components/Sundial.astro';
import {
	SITE,
	UI,
	asset,
	categoryOf,
	formatDateDot,
	formatMonthDay,
	isoDate,
	readingMinutes,
	withBase,
} from '../config';
import { getAuthorIndex } from '../authors';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const latest = posts[0];
const writing = posts.slice(1, 6);
const recent = posts.slice(0, 6);
const authors = await getAuthorIndex();
const year = new Date().getFullYear();

const tagCounts = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.data.tags) {
		tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
	}
}
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 10);

/* The latest post's cover, when it has one. The two photographs configured in
   settings.json are the 工作 / 时日 banner prints on their own pages now, so
   the home feature is drawn in paper rather than cropping one of them. */
const featureCover = asset(latest?.data.cover);

/* Rendered at build time, corrected in the browser by site.ts — so the page
   still carries a plausible date when the script never runs. */
const buildDate = formatDateDot(new Date());

const firstYear = posts.length
	? posts[posts.length - 1].data.pubDate.getFullYear()
	: year;

/* The 时日 photograph from settings.json, used as the life edition's print. */
const daysPhoto = asset(SITE.images.heroDays);

/* The two contents rows mirror the two editions: 工作 by day, 生活 by night. */
type ContentsItem = { href: string; num: string; name: string; count?: string };

const workContents: ContentsItem[] = [
	{ href: '#desk', num: 'I', name: '工作间' },
	{ href: '#latest', num: 'II', name: '最近' },
	{
		href: '#writing',
		num: 'III',
		name: '文章',
		count: String(posts.length).padStart(2, '0'),
	},
	{
		href: '#work',
		num: 'IV',
		name: '工作',
		count: String(SITE.works.length).padStart(2, '0'),
	},
	{ href: '#about', num: 'V', name: '关于' },
];

const lifeContents: ContentsItem[] = [
	{ href: '#desk', num: 'I', name: '工作间' },
	{
		href: '#days',
		num: 'II',
		name: '日子',
		count: String(posts.length).padStart(2, '0'),
	},
	{ href: '#now', num: 'III', name: '此刻' },
	{ href: '#about-life', num: 'IV', name: '关于' },
];
---

<BaseLayout title="工作与时日" description={SITE.description}>
	<section class="hero" aria-labelledby="hero-title">
		<div class="hero__dial">
			<Sundial />
		</div>

		<div class="hero__meta">
			<span>个人博客 / Personal blog</span>
			<span>{UI.volume} — {year}</span>
		</div>

		<div class="hero__body">
			<div class="hero__copy">
				<p class="hero__kicker">
					<span
						data-mode-copy
						data-day="文字、图像与缓慢发生的事"
						data-night="夜色、阅读与一些很小的日子">文字、图像与缓慢发生的事</span>
				</p>

				<p class="hero__greek" aria-hidden="true" lang="el">{UI.heroGreek}</p>

				<h1 class="hero__title" id="hero-title" aria-label="工作与时日 — Erga kai Hemerai">
					<span class="line" aria-hidden="true"><span>{UI.heroLines[0]}</span></span>
					<span class="line line--offset" aria-hidden="true"><span>{UI.heroLines[1]}</span></span>
				</h1>
			</div>

			<aside class="hero__aside">
				<p class="hero__aside-text">{SITE.description}</p>
				<a
					class="text-link hero__cta hero__cta--work"
					href={latest ? '#latest' : '#writing'}
				>
					读最近一篇 <span class="text-link__arrow">↓</span>
				</a>
				<a class="text-link hero__cta hero__cta--life" href="#days">
					翻翻最近的日子 <span class="text-link__arrow">↓</span>
				</a>
				<p class="hero__note">
					<span data-mode-copy data-day="今天也慢慢来。" data-night="夜里，时间慢下来。"
						>今天也慢慢来。</span>
					<span class="seal" aria-hidden="true">日</span>
				</p>
			</aside>
		</div>

		<nav class="hero__contents hero__contents--work" aria-label="页内目录（工作）">
			{
				workContents.map((item) => (
					<a href={item.href}>
						<span class="contents__num">{item.num}</span>
						<span class="contents__name">{item.name}</span>
						<span class="contents__leader" aria-hidden="true"></span>
						{item.count && <span class="contents__count">{item.count}</span>}
					</a>
				))
			}
		</nav>

		<nav class="hero__contents hero__contents--life" aria-label="页内目录（生活）">
			{
				lifeContents.map((item) => (
					<a href={item.href}>
						<span class="contents__num">{item.num}</span>
						<span class="contents__name">{item.name}</span>
						<span class="contents__leader" aria-hidden="true"></span>
						{item.count && <span class="contents__count">{item.count}</span>}
					</a>
				))
			}
		</nav>

		<div class="hero__foot">
			<span class="hero__status">
				<span class="mini-dial" aria-hidden="true"><span></span></span>
				<span data-day-status>一天已过 0%</span>
			</span>
			<span class="hero__mark">
				<span data-mode-mark>工作</span><i>·</i><span data-mode-mark-en>W</span>
			</span>
			<time data-date datetime={isoDate(new Date())}>{buildDate}</time>
		</div>
	</section>

	<!-- 概念演示：一张桌子，白天是工作，夜里是生活。 -->
	<section class="section section--lined" id="desk" aria-labelledby="desk-title">
		<div class="container">
			<header class="section-head">
				<div data-reveal>
					<p class="section-kicker">01 — Concept / 概念演示</p>
					<h2 class="section-title" id="desk-title">一张桌子，两种时刻。</h2>
				</div>
			</header>

			<figure class="desk" data-reveal style="--reveal-delay:120ms">
				<div class="desk__stage">
					<div class="desk__canvas" data-desk-scene></div>
					<span class="desk__state" data-desk-state>工作 / 白天</span>
				</div>
				<figcaption class="desk__caption">
					<span>工作间 / 概念演示</span>
					<span class="desk__sun" data-sun-times>日出 · 日落</span>
					<span>three.js</span>
				</figcaption>
			</figure>
		</div>
	</section>

	<!-- 工作版：白天（以及手动切到「工作」时）看到的是这一套。 -->
	<div class="edition edition--work">
	{
		latest && (
			<section class="section section--lined band" id="latest" aria-labelledby="latest-title">
				<div class="container feature">
					<div class="feature__copy" data-reveal>
						<p class="section-kicker">02 — Latest / 最近一篇</p>

						<h2 id="latest-title">
							<a class="feature__title" href={withBase(`/blog/${latest.id}/`)}>
								{latest.data.title}
							</a>
						</h2>

						{latest.data.description && (
							<p class="feature__excerpt">{latest.data.description}</p>
						)}

						<div class="meta-line feature__meta">
							<time datetime={isoDate(latest.data.pubDate)}>
								{formatDateDot(latest.data.pubDate)}
							</time>
							<span>{categoryOf(latest)}</span>
							<span>{readingMinutes(latest.body)} 分钟阅读</span>
						</div>

						<a class="text-link feature__link" href={withBase(`/blog/${latest.id}/`)}>
							阅读全文 <span class="text-link__arrow">↗</span>
						</a>
					</div>

					<div class="feature__art" data-reveal style="--reveal-delay:120ms">
						{
							featureCover ? (
								<figure class="feature__print print" style="--print-tilt: 1.4deg">
									<Figure
										src={featureCover}
										alt={latest.data.coverAlt || latest.data.title}
										label="题图"
										ratio="4 / 4.5"
										sizes="(max-width: 60rem) 100vw, 40vw"
									/>
									<figcaption class="print__caption">
										<span>最近一篇</span><span>LATEST</span>
									</figcaption>
								</figure>
							) : (
								/* No cover: the demo's own device — two sheets of paper,
								   a rule, a dot and one character. */
								<figure class="paper-art">
									<span class="paper-art__sheet paper-art__sheet--back" aria-hidden="true"
									></span>
									<span class="paper-art__sheet paper-art__sheet--front" aria-hidden="true">
										<span class="paper-art__char">工</span>
									</span>
									<span class="paper-art__rule" aria-hidden="true"></span>
									<span class="paper-art__dot" aria-hidden="true"></span>
									<span class="paper-art__note" aria-hidden="true">WORK NOTE / 001</span>
									<figcaption>工作笔记 / 关于此刻</figcaption>
								</figure>
							)
						}
					</div>
				</div>
			</section>
		)
	}

	<section class="section section--lined" id="writing" aria-labelledby="writing-title">
		<div class="container">
			<header class="section-head">
				<div data-reveal>
					<p class="section-kicker">03 — Writing / 文章</p>
					<h2 class="section-title" id="writing-title">写下来的事。</h2>
				</div>
				<p class="section-note" data-reveal style="--reveal-delay:100ms">
					关于工作方法、日常观察，以及那些反复出现的问题。
					<a href={withBase('/blog/')}>全部时日 ↗</a>
				</p>
			</header>

			{
				writing.length > 0 ? (
					<div class="writing-grid">
						<ol class="article-list" data-reveal>
							{writing.map((post, index) => (
								<PostRow post={post} index={index} />
							))}
						</ol>

						<aside class="article-preview" data-article-preview aria-hidden="true">
							<p class="preview__index" data-preview-field="index">
								{String(1).padStart(2, '0')}
							</p>
							<p class="preview__category" data-preview-field="category">
								{categoryOf(writing[0])}
							</p>
							<p class="preview__title" data-preview-field="title">
								{writing[0].data.title}
							</p>
							<p class="preview__excerpt" data-preview-field="excerpt">
								{writing[0].data.description}
							</p>
							<p class="preview__meta" data-preview-field="meta">
								{formatDateDot(writing[0].data.pubDate)}
							</p>
						</aside>
					</div>
				) : (
					<p class="footnote">还没有别的文章。把 Markdown 放进 src/content/blog 即可。</p>
				)
			}
		</div>
	</section>

	<section class="section section--lined" id="work" aria-labelledby="work-title">
		<div class="container">
			<header class="section-head">
				<div data-reveal>
					<p class="section-kicker">04 — Work / 工作</p>
					<h2 class="section-title" id="work-title">做过的一些事。</h2>
				</div>
				<p class="section-note" data-reveal style="--reveal-delay:100ms">
					不是完整作品集，只是一些工作档案。条目在
					<code>src/settings.json</code> 里改。
				</p>
			</header>

			<div class="work-grid">
				{
					SITE.works.map((item, index) => (
						<article
							class="work-card"
							data-reveal
							style={`--reveal-delay:${index * 80}ms`}
						>
							<div class="work-card__top">
								<span class="work-card__index">
									{String(index + 1).padStart(2, '0')}
								</span>
								<span class="work-card__meta">{item.meta}</span>
							</div>

							<div class="work-card__art">
								{item.image ? (
									<Figure
										src={asset(item.image)}
										alt={item.title}
										label="图片"
										ratio="1.55 / 1"
										sizes="(max-width: 48rem) 100vw, 30vw"
									/>
								) : (
									<div
										class:list={[
											'work-card__art-plain',
											`work-card__art-plain--${(index % 3) + 1}`,
										]}
										aria-hidden="true"
									>
										<span></span>
										<span></span>
									</div>
								)}
							</div>

							<h3 class="work-card__title">{item.title}</h3>
							{item.description && <p class="work-card__desc">{item.description}</p>}
						</article>
					))
				}
			</div>

			<p class="footnote work-foot">
				上面三条是示例，条目与图片都在
				<code>src/settings.json</code> 的 <code>works</code> 里。
				<a href={withBase('/works/')}>打开工作页 ↗</a>
			</p>
		</div>
	</section>

	<section class="section band" id="about" aria-labelledby="about-title">
		<div class="container about-grid">
			<p class="section-kicker" data-reveal>05 — About / 关于</p>

			<div data-reveal style="--reveal-delay:80ms">
				<h2 class="about__lead" id="about-title">
					这里记录着过去，<br />以及即将成为过去的当下。
				</h2>
				<p class="about__copy">
					{SITE.title} 上面主要是正在做的工作的留档以及一些随手留下的记录。工作是永无止境的，
					时间本身也不是什么值得纪念的东西；如果不留下些过去的坐标，其实也不知道自己走到了哪里。
				</p>
				<a class="text-link about__link" href={withBase('/about/')}>
					更多关于 <span class="text-link__arrow">↗</span>
				</a>
			</div>

			<div class="about__side" data-reveal style="--reveal-delay:160ms">
				<dl class="about__meta">
					<div><dt>文章</dt><dd>{posts.length} 篇</dd></div>
					<div><dt>作者</dt><dd>{authors.list.length} 位</dd></div>
					<div><dt>起始</dt><dd>{firstYear}</dd></div>
					<div>
						<dt>更新</dt>
						<dd>{latest ? formatDateDot(latest.data.pubDate) : '—'}</dd>
					</div>
				</dl>
			</div>
		</div>
	</section>
	</div>

	<!-- 生活版：日落后换到这一套。 -->
	<div class="edition edition--life">
		<section class="section section--lined" id="days" aria-labelledby="days-title">
			<div class="container">
				<header class="section-head">
					<div data-reveal>
						<p class="section-kicker">02 — Days / 日子</p>
						<h2 class="section-title" id="days-title">最近的日子。</h2>
					</div>
					<p class="section-note" data-reveal style="--reveal-delay:100ms">
						<a href={withBase('/blog/')}>全部时日 ↗</a>
					</p>
				</header>

				<div class="life-days">
					<ol class="day-list" data-reveal>
						{
							recent.map((post) => (
								<li class="day-item">
									<time datetime={isoDate(post.data.pubDate)}>
										{formatMonthDay(post.data.pubDate)}
									</time>
									<a class="day-item__title" href={withBase(`/blog/${post.id}/`)}>
										{post.data.title}
									</a>
									{post.data.description && (
										<p class="day-item__desc">{post.data.description}</p>
									)}
								</li>
							))
						}
					</ol>

					<aside class="life-print" data-reveal style="--reveal-delay:120ms">
						{
							daysPhoto && (
								<figure class="print" style="--print-tilt: 1.6deg">
									<Figure
										src={daysPhoto}
										alt="时日：一小片天空与树"
										label="时日"
										ratio="4 / 3"
										sizes="(max-width: 62rem) 80vw, 20rem"
									/>
									<figcaption class="print__caption">
										<span>时日 / Hēmerai</span><span>DAYS</span>
									</figcaption>
								</figure>
							)
						}
						<p class="life-note">夜里读点什么，或者只是坐一会儿。</p>
					</aside>
				</div>
			</div>
		</section>

		<section class="section section--lined band" id="now" aria-labelledby="now-title">
			<div class="container now-grid">
				<div data-reveal>
					<p class="section-kicker">03 — Now / 此刻</p>
					<h2 class="section-title" id="now-title">此刻。</h2>
					<dl class="now-list">
						<div><dt>日期</dt><dd data-now-date>—</dd></div>
						<div><dt>时刻</dt><dd data-clock-time>00:00</dd></div>
						<div><dt>一天已过</dt><dd data-now-progress>0%</dd></div>
						<div><dt>篇目</dt><dd>{posts.length}</dd></div>
						<div><dt>日出 · 日落</dt><dd data-sun-times>—</dd></div>
					</dl>
				</div>

				<div class="now-side" data-reveal style="--reveal-delay:120ms">
					<p class="now-side__label">Tags / 标签</p>
					<ul class="life-tags">
						{
							tags.map(([tag, count]) => (
								<li>
									<a href={`${withBase('/search/')}?q=${encodeURIComponent(tag)}`}>
										<span>{tag}</span><span>{count}</span>
									</a>
								</li>
							))
						}
					</ul>
					<a class="text-link" href={withBase('/search/')}>
						搜索全部 <span class="text-link__arrow">↗</span>
					</a>
				</div>
			</div>
		</section>

		<section class="section band" id="about-life" aria-labelledby="about-life-title">
			<div class="container about-grid">
				<p class="section-kicker" data-reveal>04 — About / 关于</p>

				<div data-reveal style="--reveal-delay:80ms">
					<h2 class="about__lead" id="about-life-title" lang="ja">
						ようこそ、<br />erga kai hemerai の世界へ。
					</h2>
					<p class="about__translation">欢迎来到 erga kai hemerai 的世界。</p>
					<p class="about__copy">
						白天的事留在工作版里，夜里的这些字留在这里。同一个站，两种过法。
					</p>
					<a class="text-link about__link" href={withBase('/about/')}>
						更多关于 <span class="text-link__arrow">↗</span>
					</a>
				</div>

				<div class="about__side" data-reveal style="--reveal-delay:160ms">
					<dl class="about__meta">
						<div><dt>文章</dt><dd>{posts.length} 篇</dd></div>
						<div><dt>作者</dt><dd>{authors.list.length} 位</dd></div>
						<div><dt>起始</dt><dd>{firstYear}</dd></div>
						<div>
							<dt>更新</dt>
							<dd>{latest ? formatDateDot(latest.data.pubDate) : '—'}</dd>
						</div>
					</dl>
				</div>
			</div>
		</section>
	</div>
</BaseLayout>

<script>
	/**
	 * The desk scene, loaded only when the demo comes near the viewport: three.js
	 * is a large dependency and the hero should not wait for it. Once mounted the
	 * scene renders on demand (theme changes and resizes), so an idle desk costs
	 * nothing — see src/scenes/desk.ts.
	 */
	let scene: { destroy: () => void; setNight: (night: boolean, immediate?: boolean) => void } | null =
		null;
	let host: HTMLElement | null = null;
	let themeObserver: MutationObserver | null = null;
	let generation = 0;

	const isNight = () => document.documentElement.dataset.theme === 'night';

	const mount = async (target: HTMLElement) => {
		const token = ++generation;

		const { createDeskScene } = await import('../scenes/desk');
		if (token !== generation || !target.isConnected) return;

		try {
			scene = createDeskScene(target);
		} catch (error) {
			console.warn('[desk] the scene could not start', error);
			target.classList.add('desk__canvas--failed');
			target.textContent = '这个浏览器没有可用的 WebGL，桌面暂时看不到。';
			return;
		}

		themeObserver = new MutationObserver(() => scene?.setNight(isNight()));
		themeObserver.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ['data-theme'],
		});
	};

	let observer: IntersectionObserver | null = null;

	const stop = () => {
		generation++;
		scene?.destroy();
		scene = null;
		themeObserver?.disconnect();
		themeObserver = null;
		host = null;
		observer?.disconnect();
		observer = null;
	};

	const start = () => {
		if (host) return;

		host = document.querySelector<HTMLElement>('[data-desk-scene]');
		if (!host) return;

		if (!('IntersectionObserver' in window)) {
			void mount(host);
			return;
		}

		observer = new IntersectionObserver(
			(entries) => {
				if (!entries.some((entry) => entry.isIntersecting)) return;
				observer?.disconnect();
				observer = null;
				if (host) void mount(host);
			},
			{ rootMargin: '320px 0px' },
		);
		observer.observe(host);
	};

	document.addEventListener('astro:page-load', start);
	document.addEventListener('astro:before-swap', stop);
	start();
</script>

<style>
	/* ======================================================================
	   Hero
	   ====================================================================== */

	.hero {
		position: relative;
		display: flex;
		min-height: calc(100svh - 78px);
		flex-direction: column;
		padding: clamp(30px, 4.6vw, 64px) var(--pad) 0;
		overflow: hidden;
		border-block-end: 1px solid var(--line);
	}

	.hero__dial {
		position: absolute;
		inset-block-start: 6%;
		inset-inline-end: 3%;
		width: min(37vw, 560px);
		pointer-events: none;
	}

	.hero__meta {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		color: var(--muted);
		font-size: 0.75rem;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	.hero__body {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(220px, 286px);
		gap: clamp(34px, 5.5vw, 94px);
		align-items: end;
		margin: auto 0;
		padding: clamp(42px, 6vw, 84px) 0;
	}

	.hero__kicker {
		display: flex;
		align-items: center;
		gap: 13px;
		margin-block-end: clamp(24px, 3vw, 38px);
		color: var(--muted);
		font-size: 0.75rem;
		letter-spacing: 0.17em;
	}

	.hero__kicker::before {
		width: 28px;
		height: 1px;
		flex: none;
		content: '';
		background: var(--accent);
	}

	.hero__title {
		font-family: var(--font-serif);
		font-size: clamp(3.4rem, 10.2vw, 11.5rem);
		font-weight: 400;
		line-height: 1;
		letter-spacing: -0.075em;
	}

	/* The Greek phrase, small and spaced out, above the Chinese headline. The
	   headline is set in the Chinese serif so it never depends on how a
	   platform happens to resolve polytonic Greek. */
	.hero__greek {
		margin-block-end: 14px;
		color: var(--muted);
		font-family: var(--font-serif);
		font-size: clamp(0.82rem, 0.9vw, 0.95rem);
		letter-spacing: 0.18em;
	}

	/* Each line is its own mask, so the words rise out of the paper. */
	.hero__title .line {
		display: block;
		overflow: hidden;
		white-space: nowrap;
		padding-block-end: 0.08em;
	}

	.hero__title .line > span {
		display: block;
	}

	.hero__title .line--offset {
		padding-inline-start: clamp(30px, 9.6vw, 152px);
	}

	.hero__aside {
		padding-block-start: 15px;
		border-block-start: 1px solid var(--line-strong);
	}

	.hero__aside-text {
		color: var(--ink-soft);
		font-size: 0.9375rem;
		line-height: 2;
	}

	.hero__aside .text-link {
		margin-block-start: 24px;
	}

	/* The handwritten line and its seal, straight from the demo. */
	.hero__note {
		display: flex;
		width: max-content;
		align-items: center;
		gap: 11px;
		margin-block-start: 24px;
		color: var(--muted);
		font-family: var(--font-hand);
		font-size: 1rem;
		line-height: 1.2;
		letter-spacing: 0.05em;
		transform: rotate(-2deg);
		transform-origin: left center;
		transition: transform 0.4s var(--ease);
	}

	.hero__note:hover {
		transform: rotate(0deg);
	}

	.seal {
		display: grid;
		width: 22px;
		height: 22px;
		place-items: center;
		color: var(--accent-text);
		font-family: var(--font-hand);
		font-size: 0.84375rem;
		line-height: 1;
		border: 1px solid var(--accent-text);
		transform: rotate(4deg);
	}

	/* --- Contents: roman numeral, name, dot leader, count ----------------- */

	.hero__contents {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: clamp(16px, 2.6vw, 38px);
		padding-block: 15px;
		border-block-start: 1px solid var(--line);
	}

	.hero__contents a {
		display: grid;
		grid-template-columns: auto auto minmax(12px, 1fr) auto;
		gap: 8px;
		align-items: baseline;
		padding-block: 3px;
		color: var(--muted);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		transition: color 0.25s ease;
	}

	.hero__contents a:hover {
		color: var(--ink);
	}

	.contents__num {
		color: var(--accent-text);
		font-family: var(--font-serif);
		font-size: 0.75rem;
	}

	.contents__leader {
		align-self: center;
		border-block-end: 1px dotted var(--line-strong);
		transform: translateY(-1px);
		transition: border-color 0.25s ease;
	}

	.hero__contents a:hover .contents__leader {
		border-color: var(--accent);
	}

	.contents__count {
		color: var(--muted);
		font-size: 0.75rem;
		font-variant-numeric: tabular-nums;
	}

	/* --- Foot: day progress, mode mark, date ------------------------------ */

	.hero__foot {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		padding-block: 20px 24px;
		color: var(--muted);
		font-size: 0.75rem;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		border-block-start: 1px solid var(--line);
		font-variant-numeric: tabular-nums;
	}

	.hero__status {
		display: inline-flex;
		align-items: center;
		gap: 7px;
	}

	.mini-dial {
		position: relative;
		display: none;
		width: 14px;
		height: 14px;
		flex: none;
		border: 1px solid var(--line-strong);
		border-radius: 50%;
	}

	.mini-dial::before {
		position: absolute;
		inset: -1px;
		content: '';
		background: conic-gradient(
			from -90deg,
			var(--accent) 0deg var(--day-progress, 0deg),
			transparent var(--day-progress, 0deg) 360deg
		);
		border-radius: 50%;
		-webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1px));
		mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1px));
	}

	.mini-dial span {
		position: absolute;
		inset: 0;
		transform: rotate(var(--day-angle, 0deg));
	}

	.mini-dial span::before {
		position: absolute;
		inset-block-start: 0;
		inset-inline-start: 50%;
		width: 3px;
		height: 3px;
		content: '';
		background: var(--accent);
		border-radius: 50%;
		transform: translate(-50%, -50%);
	}

	.hero__mark {
		color: var(--ink);
		font-family: var(--font-serif);
		font-size: 0.8125rem;
		letter-spacing: 0.16em;
	}

	.hero__mark i {
		color: var(--accent-text);
		font-style: normal;
	}

	.hero__foot > :last-child {
		text-align: right;
	}

	/* --- Entrance choreography ------------------------------------------- */

	:global(html.js) .hero__meta,
	:global(html.js) .hero__greek,
	:global(html.js) .hero__kicker,
	:global(html.js) .hero__aside,
	:global(html.js) .hero__contents,
	:global(html.js) .hero__foot {
		opacity: 0;
		translate: 0 14px;
		transition:
			opacity 0.9s var(--ease),
			translate 0.9s var(--ease);
	}

	:global(html.js) .hero__title .line > span {
		translate: 0 115%;
		transition: translate 1.05s var(--ease);
	}

	:global(html.js.is-ready) .hero__title .line > span,
	:global(html.js.is-ready) .hero__meta,
	:global(html.js.is-ready) .hero__greek,
	:global(html.js.is-ready) .hero__kicker,
	:global(html.js.is-ready) .hero__aside,
	:global(html.js.is-ready) .hero__contents,
	:global(html.js.is-ready) .hero__foot {
		opacity: 1;
		translate: 0;
	}

	:global(html.js.is-ready) .hero__meta {
		transition-delay: 0.68s;
	}

	:global(html.js.is-ready) .hero__kicker {
		transition-delay: 0.28s;
	}

	:global(html.js.is-ready) .hero__greek {
		transition-delay: 0.34s;
	}

	:global(html.js.is-ready) .hero__title .line:nth-child(2) > span {
		transition-delay: 0.1s;
	}

	:global(html.js.is-ready) .hero__title .line:nth-child(3) > span {
		transition-delay: 0.22s;
	}

	:global(html.js.is-ready) .hero__aside {
		transition-delay: 0.52s;
	}

	:global(html.js.is-ready) .hero__contents {
		transition-delay: 0.62s;
	}

	:global(html.js.is-ready) .hero__foot {
		transition-delay: 0.68s;
	}

	/* ======================================================================
	   Latest feature
	   ====================================================================== */

	.feature {
		display: grid;
		grid-template-columns: minmax(0, 1.04fr) minmax(0, 0.96fr);
		gap: clamp(42px, 7vw, 116px);
		align-items: center;
	}

	.feature__copy {
		max-width: 40rem;
	}

	.feature__title {
		display: block;
		margin-block-start: 22px;
		font-family: var(--font-serif);
		font-size: clamp(2.1rem, 4.4vw, 4rem);
		font-weight: 400;
		line-height: 1.14;
		letter-spacing: -0.055em;
		text-wrap: balance;
		transition: color 0.35s ease;
	}

	.feature__title:hover {
		color: var(--accent-text);
	}

	.feature__excerpt {
		max-width: 33rem;
		margin-block-start: 24px;
		color: var(--ink-soft);
		font-size: 0.96875rem;
		line-height: 1.95;
	}

	.feature__meta {
		margin-block-start: 26px;
	}

	.feature__link {
		margin-block-start: 30px;
	}

	.feature__art {
		justify-self: end;
		width: min(100%, 26rem);
		min-width: 0;
	}

	.feature__print {
		width: 100%;
	}

	/* The demo's feature artwork, drawn in CSS: two loose sheets, a rule, a dot
	   and one character. It keeps the feature from depending on a photograph
	   that would have to be cropped to fit. */
	.paper-art {
		position: relative;
		margin: 0;
		aspect-ratio: 4 / 4.4;
		overflow: hidden;
		background:
			linear-gradient(135deg, rgb(255 255 255 / 0.45), transparent 46%),
			var(--paper-soft);
		border: 1px solid var(--line);
	}

	.paper-art::before {
		position: absolute;
		inset: 0;
		content: '';
		background:
			linear-gradient(90deg, transparent 49.9%, var(--line) 50%, transparent 50.1%),
			linear-gradient(0deg, transparent 49.9%, var(--line) 50%, transparent 50.1%);
		opacity: 0.5;
	}

	.paper-art__sheet {
		position: absolute;
		display: block;
		background: var(--sheet);
		border: 1px solid var(--line);
		box-shadow: 0 20px 40px rgb(58 42 26 / 0.12);
		transition: transform 0.8s var(--ease);
	}

	.paper-art__sheet--back {
		inset-block-start: 11%;
		inset-inline-start: 9%;
		width: 52%;
		height: 60%;
		transform: rotate(-6deg);
	}

	.paper-art__sheet--front {
		inset-block-start: 22%;
		inset-inline-start: 31%;
		display: grid;
		width: 56%;
		height: 64%;
		place-items: end start;
		padding: 0 0 9% 12%;
		transform: rotate(2.5deg);
	}

	.paper-art__sheet--front::before {
		position: absolute;
		inset-block-start: 24%;
		inset-inline: 12%;
		height: 1px;
		content: '';
		background: var(--line-strong);
		box-shadow:
			0 14px 0 var(--line),
			0 28px 0 var(--line),
			0 42px 0 var(--line);
	}

	.paper-art__char {
		color: var(--rose);
		font-family: var(--font-serif);
		font-size: clamp(2.2rem, 3.6vw, 3.4rem);
		line-height: 1;
		opacity: 0.9;
	}

	.paper-art__rule {
		position: absolute;
		inset-block-end: 15%;
		inset-inline-start: 10%;
		width: 34%;
		height: 1px;
		background: var(--accent);
		opacity: 0.7;
	}

	.paper-art__dot {
		position: absolute;
		inset-block-end: 19%;
		inset-inline-end: 13%;
		width: 9px;
		height: 9px;
		background: var(--orange);
		border-radius: 50%;
		box-shadow: 0 0 0 9px rgb(235 157 96 / 0.16);
	}

	.paper-art__note {
		position: absolute;
		inset-block-start: 16px;
		inset-inline-end: 16px;
		color: var(--muted);
		font-size: 0.75rem;
		letter-spacing: 0.16em;
	}

	.paper-art figcaption {
		position: absolute;
		inset-block-end: 14px;
		inset-inline-start: 16px;
		color: var(--muted);
		font-family: var(--font-serif);
		font-size: 0.8125rem;
		letter-spacing: 0.08em;
	}

	.paper-art:hover .paper-art__sheet--back {
		transform: rotate(-8deg) translate(-7px, 4px);
	}

	.paper-art:hover .paper-art__sheet--front {
		transform: rotate(1deg) translate(8px, -6px);
	}

	/* ======================================================================
	   Writing ledger
	   ====================================================================== */

	.writing-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 300px;
		gap: clamp(40px, 6vw, 92px);
		align-items: start;
	}

	.article-list {
		border-block-start: 1px solid var(--line-strong);
	}

	.article-preview {
		position: sticky;
		inset-block-start: 112px;
		min-height: 300px;
		padding-block-start: 22px;
		border-block-start: 1px solid var(--line-strong);
		transition:
			opacity 0.22s ease,
			translate 0.22s ease;
	}

	.article-preview.is-changing {
		opacity: 0.15;
		translate: 0 6px;
	}

	.preview__index {
		color: var(--accent);
		font-family: var(--font-serif);
		font-size: 3.6rem;
		line-height: 0.9;
		letter-spacing: -0.06em;
	}

	.preview__category {
		margin-block-start: 20px;
		color: var(--muted);
		font-size: 0.75rem;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	.preview__title {
		margin-block-start: 14px;
		font-family: var(--font-serif);
		font-size: 1.75rem;
		font-weight: 400;
		line-height: 1.3;
		letter-spacing: -0.04em;
	}

	.preview__excerpt {
		margin-block-start: 16px;
		color: var(--muted);
		font-size: 0.84375rem;
		line-height: 1.9;
	}

	.preview__meta {
		margin-block-start: 22px;
		padding-block-start: 12px;
		color: var(--muted);
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		border-block-start: 1px solid var(--line);
	}

	.footnote {
		margin-block-start: clamp(28px, 4vw, 44px);
		color: var(--muted);
		font-size: 0.8125rem;
		line-height: 1.9;
	}

	.footnote code {
		font-family: var(--font-mono);
		font-size: 0.9em;
		padding: 0.1em 0.3em;
		background: color-mix(in srgb, var(--paper-deep) 70%, transparent);
	}

	/* ======================================================================
	   Work archive
	   ====================================================================== */

	.work-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-block-start: 1px solid var(--line-strong);
		border-block-end: 1px solid var(--line);
	}

	.work-card {
		display: flex;
		flex-direction: column;
		padding: 22px clamp(18px, 2.5vw, 34px) 30px 0;
	}

	.work-card + .work-card {
		padding-inline-start: clamp(18px, 2.5vw, 34px);
		border-inline-start: 1px solid var(--line);
	}

	.work-card__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 14px;
		color: var(--muted);
		font-size: 0.75rem;
		letter-spacing: 0.1em;
	}

	.work-card__index {
		color: var(--accent-text);
		font-family: var(--font-serif);
		font-size: 0.8125rem;
	}

	.work-card__art {
		margin-block: 24px 26px;
	}

	/* Three CSS marks, one per card, in place of a photograph. */
	.work-card__art-plain {
		position: relative;
		aspect-ratio: 1.55 / 1;
		overflow: hidden;
		background: color-mix(in srgb, var(--paper) 42%, transparent);
		border: 1px solid var(--line);
	}

	.work-card__art-plain span {
		position: absolute;
		display: block;
		transition: transform 0.7s var(--ease);
	}

	.work-card__art-plain--1 span:nth-child(1) {
		inset-block-start: 15%;
		inset-inline-start: 15%;
		width: 50%;
		height: 60%;
		background: var(--paper-soft);
		border: 1px solid var(--line);
		box-shadow: 0 12px 24px rgb(58 49 35 / 0.08);
	}

	.work-card__art-plain--1 span:nth-child(2) {
		inset-inline-end: 16%;
		inset-block-end: 15%;
		width: 26%;
		height: 33%;
		background: var(--accent);
		opacity: 0.9;
	}

	.work-card__art-plain--2 span:nth-child(1) {
		inset-block-start: 14%;
		inset-inline-start: 33%;
		width: 40%;
		aspect-ratio: 1;
		border: 1px solid var(--line-strong);
		border-radius: 50%;
	}

	.work-card__art-plain--2 span:nth-child(2) {
		inset-block-start: 14%;
		inset-inline-start: 53%;
		width: 1px;
		height: 40%;
		background: var(--ink);
		transform-origin: bottom;
		transform: rotate(34deg);
	}

	.work-card__art-plain--3 span:nth-child(1) {
		inset-block-start: 19%;
		inset-inline-start: 14%;
		width: 54%;
		height: 48%;
		background: var(--paper-soft);
		border: 1px solid var(--line);
		transform: rotate(-7deg);
	}

	.work-card__art-plain--3 span:nth-child(2) {
		inset-inline-end: 14%;
		inset-block-end: 17%;
		width: 24%;
		height: 2px;
		background: var(--accent);
		transform: rotate(5deg);
	}

	.work-card:hover .work-card__art-plain--1 span:nth-child(1) {
		transform: translate(-5px, -4px);
	}

	.work-card:hover .work-card__art-plain--2 span:nth-child(2) {
		transform: rotate(48deg);
	}

	.work-card:hover .work-card__art-plain--3 span:nth-child(1) {
		transform: rotate(-10deg) translate(-4px, -3px);
	}

	.work-card__title {
		font-family: var(--font-serif);
		font-size: clamp(1.35rem, 2.2vw, 1.75rem);
		font-weight: 400;
		line-height: 1.3;
		letter-spacing: -0.035em;
	}

	.work-card__desc {
		margin-block-start: 8px;
		color: var(--muted);
		font-size: 0.8125rem;
		line-height: 1.85;
		letter-spacing: 0.02em;
	}

	.work-foot {
		margin-block-start: 26px;
	}

	/* ======================================================================
	   About band
	   ====================================================================== */

	.about-grid {
		display: grid;
		grid-template-columns: minmax(120px, 0.3fr) minmax(0, 1.05fr) minmax(180px, 0.5fr);
		gap: clamp(34px, 6vw, 104px);
		align-items: start;
	}

	.about__lead {
		font-family: var(--font-serif);
		font-size: clamp(1.9rem, 3.4vw, 3.15rem);
		font-weight: 400;
		line-height: 1.42;
		letter-spacing: -0.045em;
		text-wrap: balance;
	}

	.about__translation {
		margin-block-start: 18px;
		color: var(--ink-soft);
		font-family: var(--font-serif);
		font-size: clamp(1rem, 1.2vw, 1.15rem);
		letter-spacing: 0.02em;
	}

	/* The kicker's column is narrow; keep "04 — About / 关于" on one line. */
	.about-grid > .section-kicker {
		white-space: nowrap;
	}

	.about__copy {
		max-width: 35rem;
		margin-block-start: 22px;
		color: var(--muted);
		font-size: 0.9375rem;
		line-height: 2;
	}

	.about__link {
		margin-block-start: 30px;
	}

	.about__meta {
		padding-block-start: 3px;
		border-block-start: 1px solid var(--line-strong);
	}

	.about__meta div {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 14px;
		padding-block: 12px;
		border-block-end: 1px solid var(--line);
	}

	.about__meta dt {
		color: var(--muted);
		font-size: 0.75rem;
		letter-spacing: 0.11em;
		text-transform: uppercase;
	}

	.about__meta dd {
		font-family: var(--font-serif);
		font-size: 0.9375rem;
		text-align: right;
	}

	/* ======================================================================
	   Concept demo — the three.js desk
	   ====================================================================== */

	.desk {
		margin: 0;
		background: var(--paper-soft);
		border: 1px solid var(--line);
	}

	.desk__stage {
		position: relative;
		aspect-ratio: 16 / 8.2;
		min-height: 280px;
		overflow: hidden;
	}

	/* Paper grain and a light vignette over the render, so the diorama sits
	   inside the same material as the rest of the page instead of looking like
	   a screenshot pasted onto it. */
	.desk__stage::after {
