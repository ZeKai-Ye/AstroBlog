---
/**
 * Search.
 *
 * The static build has no server to query, so every post's title, description
 * and tags are inlined as a JSON index and filtered in the browser. The field in
 * a post's sidebar GETs here with `?q=`; tags on the 时日 page link here too.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox.astro';
import { withBase } from '../config';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const index = posts.map((post) => ({
	title: post.data.title,
	description: post.data.description,
	tags: post.data.tags,
	href: withBase(`/blog/${post.id}/`),
	date: post.data.pubDate.toISOString().slice(0, 10),
}));

// `</script>` inside the payload would close the tag early.
const indexJson = JSON.stringify(index).replace(/</g, '\\u003c');
---

<BaseLayout title="搜索" description="站内搜索">
	<div class="container page-head page-head--lined">
		<p class="section-kicker">Index / 搜索</p>
		<h1 class="page-head__title">找一篇。</h1>
		<p class="page-head__lede">
			在这个站点的 {posts.length} 篇文章里查找。标题、摘要与标签都会参与匹配。
		</p>
	</div>

	<div class="container search-page">
		<div class="search-page__field">
			<SearchBox />
		</div>

		<p class="search-page__status" data-search-status aria-live="polite"></p>

		<ol class="rows search-page__results" data-search-results></ol>
	</div>

	<script id="search-index" type="application/json" is:inline set:html={indexJson}></script>

	<script>
		type Entry = {
			title: string;
			description: string;
			tags: string[];
			href: string;
			date: string;
		};

		const indexEl = document.getElementById('search-index');
		const resultsEl = document.querySelector<HTMLOListElement>('[data-search-results]');
		const statusEl = document.querySelector<HTMLParagraphElement>('[data-search-status]');
		const input = document.querySelector<HTMLInputElement>('#site-search');

		if (indexEl && resultsEl && statusEl) {
			const entries: Entry[] = JSON.parse(indexEl.textContent || '[]');
			const query = new URLSearchParams(location.search).get('q')?.trim() ?? '';

			if (input) input.value = query;

			const haystack = (entry: Entry) =>
				[entry.title, entry.description, ...entry.tags].join(' ').toLowerCase();

			const render = (matches: Entry[]) => {
				resultsEl.replaceChildren(
					...matches.map((entry) => {
						const li = document.createElement('li');
						li.className = 'search-row';

						const a = document.createElement('a');
						a.href = entry.href;

						const head = document.createElement('span');
						head.className = 'search-row__head';

						const title = document.createElement('span');
						title.className = 'search-row__title';
						title.textContent = entry.title;

						const date = document.createElement('time');
						date.className = 'search-row__date';
						date.dateTime = entry.date;
						date.textContent = entry.date.replaceAll('-', '.');

						head.append(title, date);
						a.append(head);

						if (entry.description) {
							const excerpt = document.createElement('span');
							excerpt.className = 'search-row__excerpt';
							excerpt.textContent = entry.description;
							a.append(excerpt);
						}

						li.append(a);
						return li;
					}),
				);
			};

			if (!query) {
				statusEl.textContent = '输入关键词后回车。';
				render([]);
			} else {
				const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
				const matches = entries.filter((entry) =>
					terms.every((term) => haystack(entry).includes(term)),
				);
				statusEl.textContent = matches.length
					? `找到 ${matches.length} 篇`
					: `没有匹配「${query}」的文章`;
				render(matches);
			}
		}
	</script>
</BaseLayout>

<style>
	.search-page {
		padding-block-end: var(--section-pad);
	}

	.search-page__field {
		max-width: 34rem;
	}

	.search-page__status {
		margin-block-start: 18px;
		color: var(--muted);
		font-size: 0.8125rem;
		letter-spacing: 0.04em;
	}

	.search-page__results {
		margin-block-start: 22px;
	}

	/* The rows are built in the browser, so they need global selectors. */
	:global(.search-row) {
		border-block-end: 1px solid var(--line);
	}

	:global(.search-row a) {
		display: grid;
		gap: 6px;
		padding-block: 20px;
		transition: color 0.25s ease;
	}

	:global(.search-row a:hover) {
		color: var(--accent);
	}

	:global(.search-row__head) {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
	}

	:global(.search-row__title) {
		font-family: var(--font-serif);
		font-size: clamp(1.1rem, 1.7vw, 1.45rem);
		line-height: 1.4;
		letter-spacing: -0.025em;
	}

	:global(.search-row__date) {
		flex: none;
		color: var(--muted);
		font-size: 0.75rem;
		letter-spacing: 0.04em;
		font-variant-numeric: tabular-nums;
	}

	:global(.search-row__excerpt) {
		color: var(--muted);
		font-size: 0.84375rem;
		line-height: 1.85;
	}
</style>
