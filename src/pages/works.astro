---
/**
 * 工作 / Ἔργα.
 *
 * The mockup links to this section from the hero pill but never draws it, so
 * this is a deliberate placeholder: it keeps the design's type and rhythm and
 * documents where real entries should go.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import WaveBand from '../components/WaveBand.astro';
import Figure from '../components/Figure.astro';
import { asset } from '../config';

/* `image` is a file name inside src/assets/ — see the README. */
const placeholder = [
	{ title: '项目一', meta: '2024 · 进行中', image: '' },
	{ title: '项目二', meta: '2023 · 已归档', image: '' },
	{ title: '项目三', meta: '2022 · 已归档', image: '' },
];
---

<BaseLayout title="工作" surface="tan">
	<div class="container intro">
		<h1 class="section-label intro__label">工作</h1>
		<p class="intro__sub">Ἔργα</p>
	</div>

	<WaveBand class="band">
		<div class="container band-inner">
			<ul class="works">
				{
					placeholder.map((item) => (
						<li class="works__item">
							<Figure
								class="works__media"
								src={asset(item.image)}
								alt={item.title}
								label="图片"
								ratio="4 / 3"
							/>
							<div class="works__text">
								<h2 class="works__title">{item.title}</h2>
								<p class="works__meta">{item.meta}</p>
							</div>
						</li>
					))
				}
			</ul>

			<p class="works__note">
				这一页还是空的。真实条目可以在这里接入一个 `works` 内容集合，样式沿用上面的图形 + 说明结构。
			</p>
		</div>
	</WaveBand>
</BaseLayout>

<style>
	.intro {
		display: grid;
		justify-items: center;
		gap: 0.4rem;
		padding-block: var(--section-pad);
	}

	.intro__label {
		text-align: center;
	}

	.intro__sub {
		font-size: var(--fs-meta);
		color: var(--c-ink-muted);
		letter-spacing: 0.06em;
	}

	.works {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: clamp(1.5rem, 4vw, 3rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.works__item {
		display: grid;
		gap: 1rem;
	}

	.works__title {
		font-size: var(--fs-lead);
		font-weight: 700;
		line-height: 1.3;
	}

	.works__meta {
		font-size: var(--fs-meta);
		color: var(--c-ink-muted);
	}

	.works__note {
		margin-block-start: clamp(2rem, 4vw, 3rem);
		padding-block-start: 1.15rem;
		border-block-start: 1px solid var(--c-divider);
		font-size: var(--fs-meta);
		color: var(--c-ink-muted);
	}
</style>
