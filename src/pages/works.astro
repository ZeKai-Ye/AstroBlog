---
/**
 * 工作 / Ἔργα.
 *
 * The mockup links to this section from the hero pill but never draws it. The
 * entries come from `SITE.works` in src/config.ts, so titles and pictures are
 * edited in one place; on its own the list is just sample copy.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import WaveBand from '../components/WaveBand.astro';
import Figure from '../components/Figure.astro';
import { SITE, asset } from '../config';
---

<BaseLayout title="工作" surface="tan">
	<div class="container intro">
		<h1 class="section-label intro__label">工作</h1>
		<p class="intro__sub">Ἔργα</p>
	</div>

	<WaveBand class="band">
		<div class="container band-inner">
			<ul class="works">
				{
					SITE.works.map((item) => (
						<li class="works__item">
							<Figure
								class="works__media"
								src={asset(item.image)}
								alt={item.title}
								label="图片"
								ratio="4 / 3"
							/>
							<div class="works__text">
								<h2 class="works__title">{item.title}</h2>
								<p class="works__meta">{item.meta}</p>
							</div>
						</li>
					))
				}
			</ul>

			<p class="works__note">
				上面三条是示例。在 <code>src/config.ts</code> 的 <code>SITE.works</code> 里改标题、说明和图片，
				图片写 <code>src/assets/</code> 里的文件名即可；要更多条目就往数组里加。
			</p>
		</div>
	</WaveBand>
</BaseLayout>

<style>
	.intro {
		display: grid;
		justify-items: center;
		gap: 0.4rem;
		padding-block: var(--section-pad);
	}

	.intro__label {
		text-align: center;
	}

	.intro__sub {
		font-size: var(--fs-meta);
		color: var(--c-ink-muted);
		letter-spacing: 0.06em;
	}

	.works {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: clamp(1.5rem, 4vw, 3rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.works__item {
		display: grid;
		gap: 1rem;
	}

	.works__title {
		font-size: var(--fs-lead);
		font-weight: 700;
		line-height: 1.3;
	}

	.works__meta {
		font-size: var(--fs-meta);
		color: var(--c-ink-muted);
	}

	.works__note {
		margin-block-start: clamp(2rem, 4vw, 3rem);
		padding-block-start: 1.15rem;
		border-block-start: 1px solid var(--c-divider);
		font-size: var(--fs-meta);
		color: var(--c-ink-muted);
	}
</style>
